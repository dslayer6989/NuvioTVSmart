index 0000000000000000000000000000000000000000..3f05f53c6b317c2a9952537d6a2f10996dac52fd
--- /dev/null
+++ b/js/livetv/liveTvItemType.js
@@ -0,0 +1,13 @@
+// Item type the player uses for live channels. Watch progress, Continue Watching and
+// scrobbling all skip it, so live channels never show up as half-watched titles.
+// (Kept in its own file so low-level modules can import it without pulling in the UI.)
+
+export const LIVE_TV_ITEM_TYPE = "channel";
+
+export function isLiveTvItemType(itemType) {
+  return (
+    String(itemType || "")
+      .trim()
+      .toLowerCase() === LIVE_TV_ITEM_TYPE
+  );
+}
diff --git a/js/livetv/liveTvLoader.js b/js/livetv/liveTvLoader.js
new file mode 100644
index 0000000000000000000000000000000000000000..719adaf51a4b60eeeebd6bd992fe6ddee818e9d6
--- /dev/null
+++ b/js/livetv/liveTvLoader.js
@@ -0,0 +1,180 @@
+// Loads a full guide (lineup, schedule, chips) from a Stremio Live TV addon.
+
+import {
+  LiveTvGuideBuilder,
+  LIVE_TV_GUIDE_MAX_SPAN_MS,
+  buildAddonResourceUrl,
+  buildCatalogUrl,
+  guideWindow,
+  normalizeManifestUrl,
+  planCatalogs
+} from "./liveTvGuide.js";
+import {
+  LIVE_TV_EXTRA_DATE,
+  LIVE_TV_EXTRA_SKIP,
+  addonSupportsResource,
+  catalogSupportsExtra,
+  parseCatalog,
+  parseManifest,
+  parseMetaResponse,
+  requiredExtraDefaults
+} from "./liveTvParser.js";
+import { utcDatesBetween } from "./liveTvTime.js";
+
+export const LIVE_TV_MAX_CATALOG_PAGES = 20;
+export const LIVE_TV_MAX_GROUP_PAGES = 5;
+export const LIVE_TV_MAX_META_FALLBACK_CHANNELS = 250;
+export const LIVE_TV_META_FALLBACK_CONCURRENCY = 6;
+
+async function settle(promise) {
+  try {
+    return await promise;
+  } catch (_) {
+    return null;
+  }
+}
+
+async function mapWithConcurrency(items, limit, task) {
+  const results = new Array(items.length).fill(null);
+  let cursor = 0;
+  const workers = Array.from({ length: Math.min(limit, items.length) }, async () => {
+    while (cursor < items.length) {
+      const index = cursor;
+      cursor += 1;
+      results[index] = await settle(task(items[index], index));
+    }
+  });
+  await Promise.all(workers);
+  return results;
+}
+
+async function fetchAllPages(fetchJson, manifestUrl, catalog, baseExtras, maxPages) {
+  const results = [];
+  const seen = new Set();
+  let skip = 0;
+  for (let page = 0; page < maxPages; page += 1) {
+    const extras = skip > 0 ? { ...baseExtras, [LIVE_TV_EXTRA_SKIP]: String(skip) } : baseExtras;
+    let items;
+    try {
+      items = parseCatalog(
+        await fetchJson(buildCatalogUrl(manifestUrl, catalog, extras)),
+        catalog.type
+      );
+    } catch (error) {
+      // The first page must work; a failing later page (often a missing last page) ends paging.
+      if (page === 0) throw error;
+      break;
+    }
+    if (!items.length) break;
+    const fresh = items.filter((item) => {
+      if (seen.has(item.channel.id)) return false;
+      seen.add(item.channel.id);
+      return true;
+    });
+    if (!fresh.length) break; // the addon ignored `skip`
+    results.push(...fresh);
+    if (!catalogSupportsExtra(catalog, LIVE_TV_EXTRA_SKIP)) break;
+    skip += items.length;
+  }
+  return results;
+}
+
+/**
+ * @param {string} manifestUrl any form the user typed; normalized here
+ * @param {{ nowMs?: number, fetchJson: (url: string) => Promise<any> }} options
+ */
+export async function loadLiveTvGuide(manifestUrl, { nowMs = Date.now(), fetchJson }) {
+  const normalizedUrl = normalizeManifestUrl(manifestUrl);
+  const info = parseManifest(await fetchJson(normalizedUrl));
+  const plan = planCatalogs(info);
+  if (!plan) throw new Error("This addon has no channel catalogs Nuvio can read.");
+  const builder = new LiveTvGuideBuilder();
+  const lineupBase = requiredExtraDefaults(plan.lineup) || {};
+
+  if (plan.usesDateEpg) {
+    // Stremio's native EPG serves one page set per UTC day; fetch every day the guide can show.
+    const window = guideWindow(null, nowMs);
+    const dates = utcDatesBetween(window.startMs, window.startMs + LIVE_TV_GUIDE_MAX_SPAN_MS);
+    const pages = await Promise.all(
+      dates.map((date) =>
+        settle(
+          fetchAllPages(
+            fetchJson,
+            normalizedUrl,
+            plan.lineup,
+            { ...lineupBase, [LIVE_TV_EXTRA_DATE]: date },
+            LIVE_TV_MAX_CATALOG_PAGES
+          )
+        )
+      )
+    );
+    // Today's page decides the lineup order; later days only add programmes (and new channels).
+    pages.filter(Boolean).forEach((items) => builder.addLineup(items));
+  }
+
+  if (builder.lineupSize === 0) {
+    builder.addLineup(
+      await fetchAllPages(
+        fetchJson,
+        normalizedUrl,
+        plan.lineup,
+        lineupBase,
+        LIVE_TV_MAX_CATALOG_PAGES
+      )
+    );
+  }
+
+  const groupsPromise = Promise.all(
+    plan.groups.map(async (catalog) => {
+      const items = await settle(
+        fetchAllPages(
+          fetchJson,
+          normalizedUrl,
+          catalog,
+          requiredExtraDefaults(catalog) || {},
+          LIVE_TV_MAX_GROUP_PAGES
+        )
+      );
+      return items ? { catalog, items } : null;
+    })
+  );
+
+  // Addons without the date extra may still carry schedules on their meta endpoint.
+  if (!plan.usesDateEpg && addonSupportsResource(info, "meta")) {
+    const missing = builder
+      .lineupIds()
+      .filter((id) => !builder.hasPrograms(id))
+      .slice(0, LIVE_TV_MAX_META_FALLBACK_CHANNELS);
+    const parsed = await mapWithConcurrency(
+      missing,
+      LIVE_TV_META_FALLBACK_CONCURRENCY,
+      async (channelId) => {
+        const channel = builder.channel(channelId);
+        if (!channel) return null;
+        const url = buildAddonResourceUrl(normalizedUrl, "meta", channel.type, channel.id);
+        return parseMetaResponse(await fetchJson(url), channel.type);
+      }
+    );
+    parsed
+      .filter(Boolean)
+      .forEach((entry) => builder.addPrograms(entry.channel.id, entry.programs));
+  }
+
+  (await groupsPromise).filter(Boolean).forEach(({ catalog, items }) => {
+    builder.addGroup(catalog.id, catalog.name, items);
+  });
+
+  if (builder.lineupSize === 0) throw new Error("The addon returned no channels.");
+  return builder.build(info, normalizedUrl, nowMs);
+}
+
+/** Raw stream objects for a channel, in the addon's order (Primary first). */
+export async function loadChannelStreams(manifestUrl, channel, { fetchJson }) {
+  const url = buildAddonResourceUrl(manifestUrl, "stream", channel.type, channel.id);
+  const payload = await fetchJson(url);
+  const streams = Array.isArray(payload?.streams) ? payload.streams : [];
+  // Only streams with a direct link can play; torrents and external links are skipped.
+  return streams.filter(
+    (stream) => stream && typeof stream.url === "string" && /^https?:\/\//i.test(stream.url.trim())
+  );
+}
diff --git a/js/livetv/liveTvParser.js b/js/livetv/liveTvParser.js
new file mode 100644
index 0000000000000000000000000000000000000000..8b587235322570b08e1c8d155cd417fd954a3474
--- /dev/null
+++ b/js/livetv/liveTvParser.js
@@ -0,0 +1,177 @@
+// Parses Stremio addon responses for Live TV, including Stremio's native EPG protocol:
+// `behaviorHints.epgProvider` in the manifest, a `date` catalog extra, and `metasDetailed`
+// entries whose `videos` carry `startTime`/`endTime`.
+
+import { MINUTE_MS, parseInstant, parseRuntimeMinutes } from "./liveTvTime.js";
+
+export const LIVE_TV_EXTRA_DATE = "date";
+export const LIVE_TV_EXTRA_SKIP = "skip";
+
+/** Stremio content types that describe live channels. */
+export const LIVE_TV_CHANNEL_TYPES = new Set(["tv", "channel", "live", "livetv", "events"]);
+
+function text(value) {
+  if (value == null || typeof value === "object") return null;
+  const trimmed = String(value).trim();
+  return trimmed ? trimmed : null;
+}
+
+function textList(value) {
+  if (Array.isArray(value)) return value.map(text).filter(Boolean);
+  const single = text(value);
+  return single ? [single] : [];
+}
+
+function isObject(value) {
+  return Boolean(value) && typeof value === "object" && !Array.isArray(value);
+}
+
+function sameName(left, right) {
+  return String(left || "").toLowerCase() === String(right || "").toLowerCase();
+}
+
+export function createCatalogInfo({ type, id, name, extras = [] }) {
+  return { type, id, name: name || id, extras };
+}
+
+export function catalogSupportsExtra(catalog, name) {
+  return (catalog?.extras || []).some((extra) => sameName(extra.name, name));
+}
+
+/**
+ * Values for required extras we can fill in automatically (the first declared option).
+ * `date` and `skip` are supplied by the loader, so they never block a catalog.
+ * Returns null when a required extra has no options (for example `search`).
+ */
+export function requiredExtraDefaults(catalog) {
+  const values = {};
+  for (const extra of catalog?.extras || []) {
+    if (!extra.isRequired) continue;
+    if (sameName(extra.name, LIVE_TV_EXTRA_DATE) || sameName(extra.name, LIVE_TV_EXTRA_SKIP))
+      continue;
+    const option = extra.options?.[0];
+    if (option == null) return null;
+    values[extra.name] = option;
+  }
+  return values;
+}
+
+export function isCatalogRequestable(catalog) {
+  return requiredExtraDefaults(catalog) != null;
+}
+
+function parseExtras(catalog) {
+  const declared = (Array.isArray(catalog.extra) ? catalog.extra : [])
+    .filter(isObject)
+    .map((extra) => ({
+      name: text(extra.name),
+      isRequired: extra.isRequired === true,
+      options: textList(extra.options)
+    }))
+    .filter((extra) => extra.name);
+  if (declared.length) return declared;
+  // Legacy manifests: extraSupported / extraRequired string arrays.
+  const required = new Set(textList(catalog.extraRequired));
+  const names = Array.from(new Set([...textList(catalog.extraSupported), ...required]));
+  return names.map((name) => ({ name, isRequired: required.has(name), options: [] }));
+}
+
+export function parseManifest(payload) {
+  const root = typeof payload === "string" ? JSON.parse(payload) : payload;
+  if (!isObject(root)) throw new Error("The addon manifest is not a JSON object.");
+  const catalogs = (Array.isArray(root.catalogs) ? root.catalogs : [])
+    .filter(isObject)
+    .map((catalog) => {
+      const type = text(catalog.type);
+      const id = text(catalog.id);
+      if (!type || !id) return null;
+      return createCatalogInfo({
+        type,
+        id,
+        name: text(catalog.name) || id,
+        extras: parseExtras(catalog)
+      });
+    })
+    .filter(Boolean);
+  const resources = (Array.isArray(root.resources) ? root.resources : [])
+    .map((resource) => (isObject(resource) ? text(resource.name) : text(resource)))
+    .filter(Boolean);
+  return {
+    id: text(root.id) || "",
+    name: text(root.name) || "Live TV",
+    logo: text(root.logo) || text(root.icon),
+    description: text(root.description),
+    epgProvider: isObject(root.behaviorHints) && root.behaviorHints.epgProvider === true,
+    types: textList(root.types),
+    resources,
+    catalogs
+  };
+}
+
+export function addonSupportsResource(info, name) {
+  return !info.resources.length || info.resources.some((resource) => sameName(resource, name));
+}
+
+function parseProgram(video, channelId, hasScheduledVideos) {
+  const explicitStart = parseInstant(text(video.startTime) || text(video.start));
+  // `released` alone only means "schedule" when the addon says so; otherwise it's an upload date.
+  const start = explicitStart ?? (hasScheduledVideos ? parseInstant(text(video.released)) : null);
+  if (start == null) return null;
+  const explicitEnd = parseInstant(text(video.endTime) || text(video.end) || text(video.stop));
+  const runtimeMinutes = parseRuntimeMinutes(text(video.runtime));
+  const runtimeEnd = runtimeMinutes ? start + runtimeMinutes * MINUTE_MS : null;
+  const end = explicitEnd ?? runtimeEnd;
+  return {
+    id: text(video.id) || `${channelId}:${start}`,
+    title: text(video.title) || text(video.name) || "Untitled",
+    startMs: start,
+    endMs: end != null && end > start ? end : null,
+    description: text(video.overview) || text(video.description),
+    thumbnail: text(video.thumbnail) || text(video.poster),
+    genres: textList(video.genres).length ? textList(video.genres) : textList(video.genre),
+    releaseInfo: text(video.releaseInfo)
+  };
+}
+
+function parseMeta(meta, fallbackType) {
+  const id = text(meta?.id);
+  if (!id) return null;
+  const hasScheduledVideos =
+    isObject(meta.behaviorHints) && meta.behaviorHints.hasScheduledVideos === true;
+  const genres = textList(meta.genres);
+  const channel = {
+    id,
+    type: text(meta.type) || fallbackType,
+    name: text(meta.name) || id,
+    logo: text(meta.logo) || text(meta.poster) || text(meta.background),
+    genres: genres.length ? genres : textList(meta.genre),
+    description: text(meta.description),
+    number: 0
+  };
+  const programs = (Array.isArray(meta.videos) ? meta.videos : [])
+    .filter(isObject)
+    .map((video) => parseProgram(video, id, hasScheduledVideos))
+    .filter(Boolean);
+  return { channel, programs };
+}
+
+/** Parses `catalog` responses (`metasDetailed` for EPG pages, `metas` otherwise). */
+export function parseCatalog(payload, fallbackType) {
+  const root = typeof payload === "string" ? JSON.parse(payload) : payload;
+  if (!isObject(root)) return [];
+  const metas = Array.isArray(root.metasDetailed)
+    ? root.metasDetailed
+    : Array.isArray(root.metas)
+      ? root.metas
+      : [];
+  return metas
+    .filter(isObject)
+    .map((meta) => parseMeta(meta, fallbackType))
+    .filter(Boolean);
+}
+
+/** Parses a `meta` response. */
+export function parseMetaResponse(payload, fallbackType) {
+  const root = typeof payload === "string" ? JSON.parse(payload) : payload;
+  return isObject(root?.meta) ? parseMeta(root.meta, fallbackType) : null;
+}
diff --git a/js/livetv/liveTvPhoneEntry.js b/js/livetv/liveTvPhoneEntry.js
new file mode 100644
index 0000000000000000000000000000000000000000..c460b49b8849a012c936b386e972885ff3d014f9
--- /dev/null
+++ b/js/livetv/liveTvPhoneEntry.js
@@ -0,0 +1,110 @@
+// "Set up with your phone": the TV shows a QR code for a small page it serves on the
+// home network. The phone types or pastes the addon link there, and the TV picks it up.
+// Samsung: the EngineFS web service (Tizen 5+) runs the page (port 2716 control).
+// LG: the webOS plugin service runs it. See services/livetv-phone-config.cjs.
+
+import { Platform } from "../platform/index.js";
+import { PluginServiceClient } from "../platform/pluginServiceClient.js";
+import { TizenEngineFsService } from "../platform/tizen/tizenEngineFsService.js";
+import { QrCodeGenerator } from "../core/qr/qrCodeGenerator.js";
+
+const TIZEN_CONTROL_URL = "http://127.0.0.1:2716/livetv-config";
+const POLL_MS = 1000;
+
+function randomToken() {
+  const bytes = new Uint8Array(32);
+  globalThis.crypto.getRandomValues(bytes);
+  return Array.from(bytes, (byte) => byte.toString(16).padStart(2, "0")).join("");
+}
+
+async function controlUrl() {
+  if (Platform.isTizen()) {
+    await TizenEngineFsService.ensureStarted({ purpose: "livetv-phone-setup" }).catch(() => null);
+    return TIZEN_CONTROL_URL;
+  }
+  if (Platform.isWebOS()) {
+    const health = await PluginServiceClient.ensureReady();
+    const port = Number(health?.port || 2721);
+    return `http://127.0.0.1:${port}/livetv-config`;
+  }
+  throw new Error("Phone setup needs the TV app's local service, which isn't available here.");
+}
+
+async function call(url, body) {
+  const controller = typeof AbortController === "function" ? new AbortController() : null;
+  const timer = setTimeout(() => controller?.abort(), 10000);
+  try {
+    const response = await fetch(url, {
+      method: "POST",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(body),
+      ...(controller ? { signal: controller.signal } : {})
+    });
+    if (!response.ok) throw new Error(`Phone setup service answered ${response.status}`);
+    const result = await response.json();
+    if (result?.returnValue === false) throw new Error("Phone setup service refused the request");
+    return result;
+  } finally {
+    clearTimeout(timer);
+  }
+}
+
+function tvAddress(sessionAddress) {
+  let address = String(sessionAddress || "");
+  if (!address && Platform.isTizen()) {
+    try {
+      address = globalThis.webapis?.network?.getIp?.() || "";
+    } catch (_) {
+      address = "";
+    }
+  }
+  if (!/^\d{1,3}(?:\.\d{1,3}){3}$/.test(address) || /^127\./.test(address)) return "";
+  return address;
+}
+
+/**
+ * Starts a phone session. `onLink(link)` runs each time the phone sends a link.
+ * @returns {Promise<{ url: string, qrDataUrl: string, stop: () => void }>}
+ */
+export async function startLiveTvPhoneEntry({ currentLink = "", onLink, onExpired } = {}) {
+  const url = await controlUrl();
+  const token = randomToken();
+  const session = await call(url, { action: "start", token, link: currentLink || "" });
+  const address = tvAddress(session.address);
+  if (!address) {
+    void call(url, { action: "stop", token }).catch(() => {});
+    throw new Error("The TV isn't connected to a home network, so a phone can't reach it.");
+  }
+  const pageUrl = `http://${address}:${session.port}/${token}/`;
+  const canvas = document.createElement("canvas");
+  QrCodeGenerator.generate(canvas, pageUrl, 420);
+  let stopped = false;
+  let timer = null;
+  let revision = 0;
+  const stop = () => {
+    if (stopped) return;
+    stopped = true;
+    clearTimeout(timer);
+    void call(url, { action: "stop", token }).catch(() => {});
+  };
+  const poll = async () => {
+    if (stopped) return;
+    try {
+      const state = await call(url, { action: "read", token });
+      if (stopped) return;
+      if (Number(state.revision || 0) > revision) {
+        revision = Number(state.revision || 0);
+        onLink?.(String(state.link || ""));
+      }
+    } catch (_) {
+      if (!stopped) {
+        stopped = true;
+        onExpired?.();
+      }
+      return;
+    }
+    timer = setTimeout(poll, POLL_MS);
+  };
+  timer = setTimeout(poll, POLL_MS);
+  return { url: pageUrl, qrDataUrl: canvas.toDataURL("image/png"), stop };
+}
diff --git a/js/livetv/liveTvPlayback.js b/js/livetv/liveTvPlayback.js
new file mode 100644
index 0000000000000000000000000000000000000000..8b17a544b3114c8d501279b0705ec9287e2a2aa3
--- /dev/null
+++ b/js/livetv/liveTvPlayback.js
@@ -0,0 +1,148 @@
+// Starts watching a channel from any screen (guide, On Now, Home row, the player itself):
+// fetches the channel's streams fresh, puts the source that worked last time first, and
+// opens the regular player with the rest as automatic backups.
+
+import { Router } from "../ui/navigation/routerState.js";
+import { streamRepository } from "../data/repository/streamRepository.js";
+import { LiveTvRepository } from "./liveTvRepository.js";
+import { guideChannel, normalizeManifestUrl, programAt } from "./liveTvGuide.js";
+import { showLiveTvToast } from "./ui/liveTvToast.js";
+
+import { LIVE_TV_ITEM_TYPE, isLiveTvItemType } from "./liveTvItemType.js";
+
+export { LIVE_TV_ITEM_TYPE, isLiveTvItemType };
+
+/** "Primary" for the first source, "Backup 1", "Backup 2"... after it, unless the addon names it. */
+export function liveSourceLabel(stream, index) {
+  const name = String(stream?.name || "").trim();
+  if (name) return name.replace(/\s*\n\s*/g, " · ");
+  return index === 0 ? "Primary" : `Backup ${index}`;
+}
+
+function addonRoot(manifestUrl) {
+  return normalizeManifestUrl(manifestUrl).replace(/\/manifest\.json(\?.*)?$/i, "");
+}
+
+let tuningChannelId = null;
+let tuneToken = 0;
+const tuningListeners = new Set();
+
+function setTuning(channelId) {
+  tuningChannelId = channelId || null;
+  tuningListeners.forEach((listener) => {
+    try {
+      listener(tuningChannelId);
+    } catch (_) {
+      /* A screen that went away. */
+    }
+  });
+}
+
+/**
+ * Resolves a channel's streams. Never throws.
+ * @returns {Promise<{ ok: true, channel, program, candidates } | { ok: false, message: string }>}
+ */
+export async function tuneLiveTvChannel(channelId) {
+  const state = LiveTvRepository.ensureLoaded();
+  const guide = state.guide;
+  if (!guide) return { ok: false, message: "Live TV is still loading. Try again in a moment." };
+  const channel = guideChannel(guide, channelId);
+  if (!channel) return { ok: false, message: "That channel is no longer in the lineup." };
+  let streams;
+  try {
+    streams = await LiveTvRepository.loadStreams(channel);
+  } catch (error) {
+    const reason = error?.status ? `error ${error.status}` : "network error";
+    return { ok: false, message: `Couldn't reach ${channel.name} (${reason}).` };
+  }
+  if (!streams.length) return { ok: false, message: `${channel.name} has no working streams right now.` };
+  const baseUrl = addonRoot(state.manifestUrl);
+  const candidates = streams.map((raw, index) => ({
+    ...streamRepository.mapStream(raw),
+    id: `livetv:${channel.id}:${index}:${raw.url}`,
+    addonId: guide.addonId,
+    addonBaseUrl: baseUrl,
+    addonName: guide.addonName,
+    addonLogo: guide.addonLogo || null,
+    liveSourceIndex: index
+  }));
+  return { ok: true, channel, program: programAt(guide, channel.id, Date.now()), candidates };
+}
+
+export function buildLiveTvPlayerParams({ channel, program, candidates }, { groupId = null } = {}) {
+  const first = candidates[0];
+  return {
+    streamUrl: first.url,
+    itemId: channel.id,
+    itemType: LIVE_TV_ITEM_TYPE,
+    imdbId: null,
+    tmdbId: null,
+    traktId: null,
+    videoId: null,
+    resumePositionMs: 0,
+    resumeProgressPercent: null,
+    resumeDurationMs: 0,
+    startFromBeginning: true,
+    episodeLabel: null,
+    playerTitle: channel.name,
+    playerSubtitle: program?.title || "",
+    playerEpisodeTitle: "",
+    playerReleaseYear: "",
+    playerBackdropUrl: program?.thumbnail || null,
+    playerLogoUrl: channel.logo || null,
+    season: null,
+    episode: null,
+    episodes: [],
+    streamCandidates: candidates,
+    preferredStreamId: first.id,
+    playbackSourceContext: {
+      addonId: first.addonId || "",
+      addonBaseUrl: first.addonBaseUrl || "",
+      addonName: first.addonName || "",
+      addonOrderIndex: 0,
+      sourceProviderId: "",
+      sourceIds: [],
+      selectedStreamId: first.id
+    },
+    liveTv: {
+      channelId: channel.id,
+      groupId: groupId || null
+    }
+  };
+}
+
+export const LiveTvPlayback = {
+  get tuningChannelId() {
+    return tuningChannelId;
+  },
+
+  onTuningChange(listener) {
+    tuningListeners.add(listener);
+    return () => tuningListeners.delete(listener);
+  },
+
+  /**
+   * Plays a channel. `groupId` is the chip the user was browsing, so channel up/down stays
+   * inside it. From the player itself, `replace` swaps the channel without growing history.
+   */
+  async play(channelId, { groupId = null, replace = false } = {}) {
+    const token = ++tuneToken;
+    setTuning(channelId);
+    const channelName = guideChannel(LiveTvRepository.state.guide, channelId)?.name || "channel";
+    showLiveTvToast(`Tuning to ${channelName}…`, { durationMs: 8000 });
+    try {
+      const result = await tuneLiveTvChannel(channelId);
+      if (token !== tuneToken) return false;
+      if (!result.ok) {
+        showLiveTvToast(result.message, { durationMs: 4000 });
+        return false;
+      }
+      LiveTvRepository.recordWatched(result.channel.id);
+      showLiveTvToast(`Tuning to ${result.channel.name}…`, { durationMs: 2500 });
+      await Router.navigate("player", buildLiveTvPlayerParams(result, { groupId }), replace ? { replaceHistory: true } : {});
+      return true;
+    } finally {
+      if (token === tuneToken) setTuning(null);
+    }
+  }
+};
diff --git a/js/livetv/liveTvPlayer.js b/js/livetv/liveTvPlayer.js
new file mode 100644
index 0000000000000000000000000000000000000000..79be4115125d2a2d747fb906430248026672836e
--- /dev/null
+++ b/js/livetv/liveTvPlayer.js
@@ -0,0 +1,514 @@
+// Live TV additions to the player: automatic failover to backup sources (on errors and a
+// 20-second startup watchdog), remembering the source that worked, a channel banner,
+// channel up/down, and a slide-out channel list with a Sources section.
+// Every action works with arrows, OK and Back: Left (while the controls are hidden) opens
+// the channel list. CH▲/▼ and the green button are shortcuts.
+
+import { Router } from "../ui/navigation/routerState.js";
+import { LiveTvRepository } from "./liveTvRepository.js";
+import { LiveTvPlayback, isLiveTvItemType, liveSourceLabel } from "./liveTvPlayback.js";
+import {
+  guideChannel,
+  neighborOf,
+  nextProgram,
+  programAt,
+  programProgress
+} from "./liveTvGuide.js";
+import { formatClock } from "./liveTvTime.js";
+import { escapeHtml, liveBadge, logoTile, progressBar } from "./ui/liveTvMarkup.js";
+import { hideLiveTvToast, showLiveTvToast } from "./ui/liveTvToast.js";
+
+/** How long a live source may sit on "loading" before the next backup is tried. */
+export const LIVE_TV_STARTUP_TIMEOUT_MS = 20 * 1000;
+/** How long a source must play before it becomes the channel's first choice. */
+export const LIVE_TV_REMEMBER_AFTER_MS = 8 * 1000;
+const BANNER_AFTER_TUNE_MS = 6000;
+const DEAD_SOURCE_AFTER_MS = 4000;
+const TICK_MS = 1000;
+const PROGRAM_REFRESH_MS = 30 * 1000;
+const LIST_WINDOW = 9;
+
+const KEY = {
+  LEFT: 37,
+  UP: 38,
+  RIGHT: 39,
+  DOWN: 40,
+  ENTER: 13,
+  PAGE_UP: 33,
+  PAGE_DOWN: 34,
+  CHANNEL_UP: 427,
+  CHANNEL_DOWN: 428,
+  GREEN: 404,
+  G: 71
+};
+
+function isChannelUp(code, event) {
+  return code === KEY.CHANNEL_UP || code === KEY.PAGE_UP || event?.key === "ChannelUp";
+}
+
+function isChannelDown(code, event) {
+  return code === KEY.CHANNEL_DOWN || code === KEY.PAGE_DOWN || event?.key === "ChannelDown";
+}
+
+export function createPlayerLiveTvMethods() {
+  return {
+    isLiveTvPlayback() {
+      return Boolean(this.liveTvSession) && isLiveTvItemType(this.params?.itemType);
+    },
+
+    liveTvOnMount(params = {}) {
+      this.liveTvOnCleanup();
+      document.documentElement?.classList?.add("ltv-player-active");
+      if (!params?.liveTv?.channelId || !isLiveTvItemType(params.itemType)) {
+        this.liveTvSession = null;
+        return;
+      }
+      const now = Date.now();
+      this.liveTvSession = {
+        channelId: params.liveTv.channelId,
+        groupId: params.liveTv.groupId || null,
+        mountToken: this.playerMountToken,
+        sourceStartedAt: now,
+        bannerUntil: now + BANNER_AFTER_TUNE_MS,
+        frameSince: 0,
+        remembered: false,
+        exhausted: false,
+        lastProgramRefresh: now,
+        toastHidden: false
+      };
+      this.liveTvListOpen = false;
+      this.liveTvListIndex = 0;
+      this.liveTvTimer = setInterval(() => this.liveTvTick(), TICK_MS);
+      this.liveTvTick();
+    },
+
+    liveTvOnCleanup() {
+      clearInterval(this.liveTvTimer);
+      this.liveTvTimer = null;
+      this.liveTvSession = null;
+      this.liveTvListOpen = false;
+      this.container?.querySelector?.("#ltvPlayerOverlay")?.remove();
+      document.documentElement?.classList?.remove("ltv-player-active");
+    },
+
+    liveTvChannel() {
+      return guideChannel(LiveTvRepository.state.guide, this.liveTvSession?.channelId);
+    },
+
+    liveTvSessionChannels() {
+      return LiveTvRepository.channelsForSession(this.liveTvSession?.groupId);
+    },
+
+    liveTvCurrentSourceIndex() {
+      return Math.max(0, Number(this.currentStreamIndex || 0));
+    },
+
+    liveTvTick() {
+      const session = this.liveTvSession;
+      if (!session || session.mountToken !== this.playerMountToken || !this.playerRouteActive)
+        return;
+      const now = Date.now();
+      if (this.hasPresentedPlaybackFrame) {
+        if (!session.frameSince) session.frameSince = now;
+        if (!session.toastHidden) {
+          session.toastHidden = true;
+          hideLiveTvToast();
+        }
+        if (!session.remembered && now - session.frameSince >= LIVE_TV_REMEMBER_AFTER_MS) {
+          session.remembered = true;
+          const candidate = this.getCurrentStreamCandidate?.();
+          if (candidate)
+            LiveTvRepository.rememberWorkingStream(session.channelId, candidate.raw || candidate);
+        }
+      } else {
+        session.frameSince = 0;
+        // A link that's gone (404, DNS failure) leaves the video element with no source;
+        // don't wait the full watchdog for it.
+        const video = globalThis.document?.getElementById?.("videoPlayer");
+        const deadSource =
+          video &&
+          video.networkState === 3 &&
+          video.readyState === 0 &&
+          now - session.sourceStartedAt >= DEAD_SOURCE_AFTER_MS;
+        if (deadSource && !session.exhausted && !this.isStartupErrorVisible?.()) {
+          console.warn("Live TV source has no media; trying the next one");
+          if (!this.liveTvTryNextSource("no-source")) {
+            session.exhausted = true;
+            this.showStartupError?.(
+              `Every source for ${this.liveTvChannel()?.name || "this channel"} failed.`,
+              {
+                reason: "live-tv-sources-exhausted"
+              }
+            );
+          }
+        } else if (
+          !session.exhausted &&
+          !this.isStartupErrorVisible?.() &&
+          now - session.sourceStartedAt >= LIVE_TV_STARTUP_TIMEOUT_MS
+        ) {
+          console.warn("Live TV source did not start in time; trying the next one");
+          if (!this.liveTvTryNextSource("startup-timeout")) {
+            session.exhausted = true;
+            this.showStartupError?.(
+              `Every source for ${this.liveTvChannel()?.name || "this channel"} failed.`,
+              {
+                reason: "live-tv-sources-exhausted"
+              }
+            );
+          }
+        }
+      }
+      if (now - session.lastProgramRefresh >= PROGRAM_REFRESH_MS) {
+        session.lastProgramRefresh = now;
+        LiveTvRepository.refreshIfStale(now);
+      }
+      this.liveTvRenderOverlay();
+    },
+
+    /**
+     * Called when the active live source fails (playback error or startup timeout).
+     * Moves to the next backup of the same channel; returns false once every source failed.
+     */
+    liveTvTryNextSource(reason = "error") {
+      const session = this.liveTvSession;
+      if (!session || !this.isLiveTvPlayback() || session.mountToken !== this.playerMountToken)
+        return false;
+      const nextIndex = this.liveTvCurrentSourceIndex() + 1;
+      const next = this.streamCandidates?.[nextIndex];
+      const channelName = this.liveTvChannel()?.name || this.params?.playerTitle || "this channel";
+      if (!next) {
+        session.exhausted = true;
+        showLiveTvToast(`Every source for ${channelName} failed`, { durationMs: 5000 });
+        return false;
+      }
+      console.warn("Live TV: switching to backup source", { reason, index: nextIndex });
+      showLiveTvToast(`Switching to ${liveSourceLabel(next, nextIndex)}…`, { durationMs: 4000 });
+      this.liveTvPlaySource(nextIndex);
+      return true;
+    },
+
+    liveTvPlaySource(index) {
+      const session = this.liveTvSession;
+      const candidate = this.streamCandidates?.[index];
+      if (!session || !candidate) return;
+      session.sourceStartedAt = Date.now();
+      session.frameSince = 0;
+      session.remembered = false;
+      session.exhausted = false;
+      session.toastHidden = false;
+      this.currentStreamIndex = index;
+      this.sourcesError = null;
+      this.loadingVisible = true;
+      this.updateLoadingVisibility?.();
+      void this.playStreamCandidate(candidate, { mountToken: this.playerMountToken });
+    },
+
+    liveTvSwitchChannel(delta) {
+      const session = this.liveTvSession;
+      if (!session) return;
+      const next = neighborOf(this.liveTvSessionChannels(), session.channelId, delta);
+      if (!next || next.id === session.channelId) return;
+      this.liveTvTuneChannel(next.id);
+    },
+
+    liveTvTuneChannel(channelId) {
+      const session = this.liveTvSession;
+      if (!session) return;
+      this.liveTvListOpen = false;
+      if (channelId === session.channelId) {
+        this.liveTvRenderOverlay();
+        return;
+      }
+      session.bannerUntil = Date.now() + BANNER_AFTER_TUNE_MS;
+      void LiveTvPlayback.play(channelId, { groupId: session.groupId, replace: true });
+    },
+
+    liveTvOpenList() {
+      const channels = this.liveTvSessionChannels();
+      this.liveTvListOpen = true;
+      this.liveTvListIndex = Math.max(
+        0,
+        channels.findIndex((channel) => channel.id === this.liveTvSession?.channelId)
+      );
+      this.setControlsVisible?.(false);
+      this.liveTvRenderOverlay();
+    },
+
+    liveTvCloseList() {
+      this.liveTvListOpen = false;
+      this.liveTvRenderOverlay();
+    },
+
+    /** Rows in the channel list: every channel of the chip, then the channel's sources. */
+    liveTvListRows() {
+      const rows = this.liveTvSessionChannels().map((channel) => ({ kind: "channel", channel }));
+      if ((this.streamCandidates || []).length > 1) {
+        this.streamCandidates.forEach((candidate, index) =>
+          rows.push({ kind: "source", candidate, index })
+        );
+      }
+      return rows;
+    },
+
+    liveTvActivateListRow() {
+      const row = this.liveTvListRows()[this.liveTvListIndex];
+      if (!row) return;
+      if (row.kind === "channel") {
+        this.liveTvTuneChannel(row.channel.id);
+        return;
+      }
+      this.liveTvListOpen = false;
+      if (row.index !== this.liveTvCurrentSourceIndex()) {
+        showLiveTvToast(`Switching to ${liveSourceLabel(row.candidate, row.index)}…`);
+        this.liveTvPlaySource(row.index);
+      }
+      this.liveTvRenderOverlay();
+    },
+
+    /** Handles Live TV keys before the regular player. Returns true when consumed. */
+    liveTvHandleKey(event) {
+      if (!this.isLiveTvPlayback()) return false;
+      const code = Number(event?.keyCode || 0);
+      const stop = () => {
+        event?.preventDefault?.();
+        event?.stopPropagation?.();
+        event?.stopImmediatePropagation?.();
+        return true;
+      };
+      if (this.liveTvListOpen) {
+        const rows = this.liveTvListRows();
+        if (code === KEY.UP || code === KEY.DOWN) {
+          this.liveTvListIndex = Math.max(
+            0,
+            Math.min(rows.length - 1, this.liveTvListIndex + (code === KEY.UP ? -1 : 1))
+          );
+          this.liveTvRenderOverlay();
+          return stop();
+        }
+        if (code === KEY.ENTER) {
+          // The Magic Remote pointer may have moved focus to another row.
+          const pointed = globalThis.document?.activeElement?.closest?.("[data-ltv-list-index]");
+          if (pointed)
+            this.liveTvListIndex = Number(pointed.dataset.ltvListIndex || this.liveTvListIndex);
+          if (!event?.repeat) this.liveTvActivateListRow();
+          return stop();
+        }
+        if (code === KEY.RIGHT || code === KEY.LEFT || code === KEY.GREEN || code === KEY.G) {
+          this.liveTvCloseList();
+          return stop();
+        }
+        if (isChannelUp(code, event) || isChannelDown(code, event)) {
+          this.liveTvSwitchChannel(isChannelUp(code, event) ? 1 : -1);
+          return stop();
+        }
+        return stop();
+      }
+      if (isChannelUp(code, event) || isChannelDown(code, event)) {
+        if (!event?.repeat) this.liveTvSwitchChannel(isChannelUp(code, event) ? 1 : -1);
+        return stop();
+      }
+      if (code === KEY.GREEN || code === KEY.G) {
+        this.liveTvOpenList();
+        return stop();
+      }
+      const otherPanelOpen =
+        this.isStartupErrorVisible?.() ||
+        this.sourcesPanelVisible ||
+        this.subtitleDialogVisible ||
+        this.audioDialogVisible ||
+        this.speedDialogVisible ||
+        this.episodePanelVisible ||
+        this.moreActionsVisible ||
+        this.streamInfoVisible ||
+        this.partyPanelVisible ||
+        this.pauseOverlayVisible;
+      if (
+        code === KEY.LEFT &&
+        this.controlsVisible &&
+        !otherPanelOpen &&
+        this.liveTvIsFirstControlFocused()
+      ) {
+        // Left from the first player button opens the channel list too.
+        this.liveTvOpenList();
+        return stop();
+      }
+      if (code === KEY.LEFT && !this.controlsVisible && !otherPanelOpen) {
+        // Live channels can't seek back far; Left opens the channel list instead.
+        this.liveTvOpenList();
+        return stop();
+      }
+      return false;
+    },
+
+    /** Where Back from a live channel goes: the screen it was started from. */
+    liveTvReturnRoute() {
+      if (!this.isLiveTvPlayback()) return null;
+      const stack = Array.isArray(Router.stack) ? Router.stack : [];
+      for (let index = stack.length - 1; index >= 0; index -= 1) {
+        const entry = stack[index];
+        const route = typeof entry === "string" ? entry : String(entry?.route || "");
+        if (route && route !== "player") {
+          return { route, params: typeof entry === "string" ? {} : entry?.params || {} };
+        }
+      }
+      return { route: "liveTv", params: {} };
+    },
+
+    liveTvIsFirstControlFocused() {
+      const active = globalThis.document?.activeElement;
+      if (!active?.classList?.contains("player-control-btn")) return false;
+      const buttons = Array.from(
+        this.container?.querySelectorAll?.(".player-control-btn") || []
+      ).filter(
+        (node) =>
+          node.offsetParent !== null &&
+          node.getBoundingClientRect().top >= active.getBoundingClientRect().top - 4 &&
+          node.getBoundingClientRect().top <= active.getBoundingClientRect().top + 4
+      );
+      return buttons[0] === active;
+    },
+
+    liveTvConsumeBack() {
+      if (!this.isLiveTvPlayback() || !this.liveTvListOpen) return false;
+      this.liveTvCloseList();
+      return true;
+    },
+
+    liveTvEnsureOverlay() {
+      let overlay = this.container?.querySelector?.("#ltvPlayerOverlay");
+      if (!overlay && this.container) {
+        overlay = document.createElement("div");
+        overlay.id = "ltvPlayerOverlay";
+        overlay.className = "ltv-player-overlay";
+        this.container.appendChild(overlay);
+        overlay.addEventListener("click", (event) => {
+          const rowNode = event.target?.closest?.("[data-ltv-list-index]");
+          if (!rowNode) return;
+          this.liveTvListIndex = Number(rowNode.dataset.ltvListIndex || 0);
+          this.liveTvActivateListRow();
+        });
+      }
+      return overlay;
+    },
+
+    liveTvRenderOverlay() {
+      const session = this.liveTvSession;
+      if (!session) return;
+      const overlay = this.liveTvEnsureOverlay();
+      if (!overlay) return;
+      const now = Date.now();
+      const guide = LiveTvRepository.state.guide;
+      const channel = this.liveTvChannel() || {
+        id: session.channelId,
+        name: this.params?.playerTitle || "",
+        logo: this.params?.playerLogoUrl
+      };
+      const program = programAt(guide, channel.id, now);
+      const upNext = nextProgram(guide, channel.id, program?.endMs ?? now);
+      const showBanner =
+        !this.liveTvListOpen && (this.controlsVisible || now < session.bannerUntil);
+      const sourceIndex = this.liveTvCurrentSourceIndex();
+      const sourceCount = (this.streamCandidates || []).length;
+      const signature = JSON.stringify([
+        showBanner,
+        this.liveTvListOpen,
+        this.liveTvListIndex,
+        channel.id,
+        program?.id,
+        Math.floor(now / 15000),
+        sourceIndex,
+        LiveTvPlayback.tuningChannelId
+      ]);
+      if (overlay.dataset.signature === signature) return;
+      overlay.dataset.signature = signature;
+      const banner = showBanner
+        ? `
+        <div class="ltv-player-banner">
+          ${logoTile(channel, "ltv-player-banner-logo")}
+          <div class="ltv-player-banner-copy">
+            <div class="ltv-player-banner-channel">
+              ${liveBadge()}
+              <span class="ltv-player-banner-number">${channel.number ? escapeHtml(String(channel.number)) : ""}</span>
+              <span class="ltv-player-banner-name">${escapeHtml(channel.name)}</span>
+            </div>
+            <div class="ltv-player-banner-title">${escapeHtml(program?.title || this.params?.playerSubtitle || "")}</div>
+            ${
+              program
+                ? `<div class="ltv-player-banner-time">${escapeHtml(`${formatClock(program.startMs)} – ${formatClock(program.endMs)}`)}</div>
+                   ${progressBar(programProgress(program, now), "ltv-player-banner-progress")}`
+                : ""
+            }
+            ${upNext ? `<div class="ltv-player-banner-next">Up next · ${escapeHtml(formatClock(upNext.startMs))} ${escapeHtml(upNext.title)}</div>` : ""}
+            <div class="ltv-player-banner-hints">
+              <span>◀ Channels</span><span>CH ▲▼ Change channel</span>
+              ${sourceCount > 1 ? `<span>Source: ${escapeHtml(liveSourceLabel(this.streamCandidates[sourceIndex], sourceIndex))}</span>` : ""}
+            </div>
+          </div>
+        </div>`
+        : "";
+      overlay.innerHTML = `${banner}${this.liveTvListOpen ? this.liveTvRenderList(now) : ""}`;
+      overlay.dataset.channelId = channel.id;
+      overlay.classList.toggle("is-list-open", Boolean(this.liveTvListOpen));
+      if (this.liveTvListOpen) {
+        overlay.querySelector(".ltv-player-list-row.focused")?.focus?.({ preventScroll: true });
+      }
+    },
+
+    liveTvRenderList(now) {
+      const guide = LiveTvRepository.state.guide;
+      const rows = this.liveTvListRows();
+      const index = Math.max(0, Math.min(rows.length - 1, this.liveTvListIndex));
+      const start = Math.max(
+        0,
+        Math.min(index - Math.floor(LIST_WINDOW / 2), rows.length - LIST_WINDOW)
+      );
+      const visible = rows.slice(start, start + LIST_WINDOW);
+      const sourceIndex = this.liveTvCurrentSourceIndex();
+      const items = visible
+        .map((row, offset) => {
+          const rowIndex = start + offset;
+          const focused = rowIndex === index;
+          if (row.kind === "source") {
+            const previous = rows[rowIndex - 1];
+            const header =
+              previous?.kind !== "source"
+                ? `<div class="ltv-player-list-section">Sources</div>`
+                : "";
+            return `${header}
+              <div class="ltv-player-list-row is-source focusable${focused ? " focused" : ""}${row.index === sourceIndex ? " is-current" : ""}"
+                   data-ltv-list-index="${rowIndex}" tabindex="-1">
+                <span class="material-icons" aria-hidden="true">${row.index === sourceIndex ? "radio_button_checked" : "radio_button_unchecked"}</span>
+                <span class="ltv-player-list-name">${escapeHtml(liveSourceLabel(row.candidate, row.index))}</span>
+              </div>`;
+          }
+          const channel = row.channel;
+          const current = programAt(guide, channel.id, now);
+          const playing = channel.id === this.liveTvSession?.channelId;
+          return `
+            <div class="ltv-player-list-row focusable${focused ? " focused" : ""}${playing ? " is-current" : ""}"
+                 data-ltv-list-index="${rowIndex}" tabindex="-1">
+              <span class="ltv-player-list-number">${channel.number ? escapeHtml(String(channel.number)) : ""}</span>
+              ${logoTile(channel, "ltv-player-list-logo")}
+              <span class="ltv-player-list-copy">
+                <span class="ltv-player-list-name">${escapeHtml(channel.name)}${playing ? " · Watching" : ""}</span>
+                <span class="ltv-player-list-program">${escapeHtml(
+                  LiveTvPlayback.tuningChannelId === channel.id
+                    ? "Tuning…"
+                    : current?.title || "No guide information"
+                )}</span>
+                ${current ? progressBar(programProgress(current, now), "ltv-player-list-progress") : ""}
+              </span>
+            </div>`;
+        })
+        .join("");
+      return `
+        <aside class="ltv-player-list" aria-label="Channels">
+          <div class="ltv-player-list-title">Channels</div>
+          <div class="ltv-player-list-hint">OK watch · ▶ or Back close</div>
+          ${start > 0 ? `<div class="ltv-player-list-more">▲</div>` : ""}
+          ${items}
+          ${start + LIST_WINDOW < rows.length ? `<div class="ltv-player-list-more">▼</div>` : ""}
+        </aside>`;
+    }
+  };
+}
diff --git a/js/livetv/liveTvRepository.js b/js/livetv/liveTvRepository.js
new file mode 100644
index 0000000000000000000000000000000000000000..b67f9595fcd437b6cad56934e78d91bdcfc386f5
--- /dev/null
+++ b/js/livetv/liveTvRepository.js
@@ -0,0 +1,387 @@
+// Live TV state shared by the guide screen, the Home row, Settings and the player:
+// the addon link, the loaded guide, and each profile's favorites, recents and chip.
+
+import { httpRequest } from "../core/network/httpClient.js";
+import { LocalStore } from "../core/storage/localStore.js";
+import { ProfileManager } from "../core/profile/profileManager.js";
+import {
+  guideChannel,
+  guideChannelsFor,
+  isAddonFavoritesGroup,
+  guideLineup,
+  normalizeManifestUrl
+} from "./liveTvGuide.js";
+import { loadChannelStreams, loadLiveTvGuide } from "./liveTvLoader.js";
+import { MINUTE_MS } from "./liveTvTime.js";
+
+export const LIVE_TV_FAVORITES_GROUP_ID = "local:favorites";
+export const LIVE_TV_RECENT_GROUP_ID = "local:recent";
+export const LIVE_TV_MAX_RECENTS = 12;
+export const LIVE_TV_STALE_AFTER_MS = 30 * MINUTE_MS;
+export const LIVE_TV_MAX_REMEMBERED_STREAMS = 200;
+export const LIVE_TV_REQUEST_TIMEOUT_MS = 15000;
+
+const KEY_MANIFEST_URL = "liveTv.manifestUrl";
+const KEY_VIEW_MODE = "liveTv.viewMode";
+const KEY_ON_NOW_SORT = "liveTv.onNowSort";
+const KEY_WORKING_STREAMS = "liveTv.workingStreams";
+// Favorites, recents and the selected chip are saved per profile.
+const KEY_FAVORITES = "liveTv.favorites";
+const KEY_RECENTS = "liveTv.recents";
+const KEY_SELECTED_GROUP = "liveTv.selectedGroup";
+
+function profileKey(key, profileId) {
+  return `${key}.${profileId}`;
+}
+
+function activeProfileId() {
+  try {
+    return ProfileManager.getActiveProfileId();
+  } catch (_) {
+    return "1";
+  }
+}
+
+function readIdList(value) {
+  return Array.isArray(value) ? value.map((id) => String(id || "")).filter(Boolean) : [];
+}
+
+async function defaultFetchJson(url) {
+  return httpRequest(url, { includeSessionAuth: false, timeoutMs: LIVE_TV_REQUEST_TIMEOUT_MS });
+}
+
+function streamLabelKey(stream) {
+  return [stream?.name, stream?.title, stream?.description]
+    .map((value) => String(value || "").trim())
+    .filter(Boolean)
+    .join("|");
+}
+
+/** Moves the remembered source to the front; everything else keeps its order for failover. */
+export function orderStreamsByPreference(streams, preferred) {
+  if (!preferred || streams.length < 2) return streams;
+  let index = preferred.url ? streams.findIndex((stream) => stream.url === preferred.url) : -1;
+  if (index < 0 && preferred.label)
+    index = streams.findIndex((stream) => streamLabelKey(stream) === preferred.label);
+  if (index <= 0) return streams;
+  return [streams[index], ...streams.filter((_, position) => position !== index)];
+}
+
+const listeners = new Set();
+let fetchJson = defaultFetchJson;
+let loadToken = 0;
+
+const state = {
+  manifestUrl: "",
+  isLoading: false,
+  isRefreshing: false,
+  errorMessage: "",
+  guide: null,
+  selectedGroupId: null,
+  viewMode: "Guide",
+  onNowSort: "Channel",
+  favoriteIds: [],
+  recentIds: [],
+  profileId: null
+};
+
+function emit() {
+  listeners.forEach((listener) => {
+    try {
+      listener(state);
+    } catch (error) {
+      console.warn("Live TV listener failed", error);
+    }
+  });
+}
+
+function saveProfileIds(key, ids) {
+  LocalStore.set(profileKey(key, state.profileId || activeProfileId()), ids);
+}
+
+function saveSelectedGroup(groupId) {
+  // An explicit "All channels" choice is stored as "" so it doesn't fall back to an older value.
+  LocalStore.set(
+    profileKey(KEY_SELECTED_GROUP, state.profileId || activeProfileId()),
+    groupId || ""
+  );
+}
+
+function seedFavoritesIfNeeded(guide) {
+  if (LocalStore.get(profileKey(KEY_FAVORITES, state.profileId), null) != null) return;
+  const seed = (guide?.groups || []).find(isAddonFavoritesGroup)?.channelIds || [];
+  saveProfileIds(KEY_FAVORITES, seed);
+  state.favoriteIds = seed.slice();
+}
+
+function isGroupValid(groupId, guide = state.guide) {
+  if (!groupId) return true;
+  if (groupId === LIVE_TV_FAVORITES_GROUP_ID) return state.favoriteIds.length > 0;
+  if (groupId === LIVE_TV_RECENT_GROUP_ID) return state.recentIds.length > 0;
+  if (!guide) return true;
+  return guide.groups.some((group) => group.id === groupId);
+}
+
+/** Swaps in the active profile's favorites, recents and chip after a profile switch. */
+function syncActiveProfile() {
+  const profileId = activeProfileId();
+  if (profileId === state.profileId) return false;
+  state.profileId = profileId;
+  state.favoriteIds = readIdList(LocalStore.get(profileKey(KEY_FAVORITES, profileId), []));
+  state.recentIds = readIdList(LocalStore.get(profileKey(KEY_RECENTS, profileId), []));
+  const storedGroup = String(LocalStore.get(profileKey(KEY_SELECTED_GROUP, profileId), "") || "");
+  state.selectedGroupId = storedGroup && isGroupValid(storedGroup) ? storedGroup : null;
+  if (state.guide) seedFavoritesIfNeeded(state.guide);
+  return true;
+}
+
+let initialized = false;
+
+function ensureInitialized() {
+  if (initialized) return;
+  initialized = true;
+  state.manifestUrl = String(LocalStore.get(KEY_MANIFEST_URL, "") || "");
+  state.viewMode = LocalStore.get(KEY_VIEW_MODE, "Guide") === "OnNow" ? "OnNow" : "Guide";
+  const sort = LocalStore.get(KEY_ON_NOW_SORT, "Channel");
+  state.onNowSort = ["Channel", "EndingSoon", "JustStarted"].includes(sort) ? sort : "Channel";
+}
+
+export const LiveTvRepository = {
+  get state() {
+    ensureInitialized();
+    return state;
+  },
+
+  subscribe(listener) {
+    listeners.add(listener);
+    return () => listeners.delete(listener);
+  },
+
+  /** For tests: replace how addon URLs are fetched. */
+  setFetcher(nextFetchJson) {
+    fetchJson = typeof nextFetchJson === "function" ? nextFetchJson : defaultFetchJson;
+  },
+
+  isConfigured() {
+    ensureInitialized();
+    return Boolean(state.manifestUrl.trim());
+  },
+
+  /** Makes sure the active profile's lists are loaded and a guide is on its way. */
+  ensureLoaded() {
+    ensureInitialized();
+    const profileChanged = syncActiveProfile();
+    if (!state.guide && !state.isLoading && !state.errorMessage && this.isConfigured()) {
+      void this.refresh();
+    } else if (profileChanged) {
+      emit();
+    }
+    return state;
+  },
+
+  async refresh({ force = false } = {}) {
+    ensureInitialized();
+    const manifestUrl = state.manifestUrl.trim();
+    if (!manifestUrl) return null;
+    if (!force && (state.isLoading || state.isRefreshing)) return null;
+    const token = ++loadToken;
+    state.isLoading = !state.guide;
+    state.isRefreshing = Boolean(state.guide);
+    state.errorMessage = "";
+    emit();
+    try {
+      const guide = await loadLiveTvGuide(manifestUrl, { nowMs: Date.now(), fetchJson });
+      if (token !== loadToken) return null;
+      syncActiveProfile();
+      seedFavoritesIfNeeded(guide);
+      state.guide = guide;
+      if (!isGroupValid(state.selectedGroupId, guide)) state.selectedGroupId = null;
+      return guide;
+    } catch (error) {
+      if (token !== loadToken) return null;
+      console.warn("Live TV guide failed to load", error);
+      // Keep showing a guide we already have; only report the error when there is nothing.
+      if (!state.guide) {
+        state.errorMessage = describeLoadError(error);
+      }
+      return null;
+    } finally {
+      if (token === loadToken) {
+        state.isLoading = false;
+        state.isRefreshing = false;
+        emit();
+      }
+    }
+  },
+
+  /** Reloads in the background once the guide is older than 30 minutes. */
+  refreshIfStale(nowMs = Date.now()) {
+    if (!state.guide || state.isLoading || state.isRefreshing) return;
+    if (nowMs - state.guide.loadedAtMs >= LIVE_TV_STALE_AFTER_MS) void this.refresh();
+  },
+
+  setManifestUrl(url) {
+    ensureInitialized();
+    const trimmed = String(url || "").trim();
+    const changed = normalizeManifestUrl(trimmed) !== normalizeManifestUrl(state.manifestUrl);
+    LocalStore.set(KEY_MANIFEST_URL, trimmed);
+    state.manifestUrl = trimmed;
+    if (!changed && state.guide) {
+      emit();
+      return;
+    }
+    loadToken += 1;
+    state.guide = null;
+    state.errorMessage = "";
+    state.isLoading = false;
+    state.isRefreshing = false;
+    state.selectedGroupId = null;
+    saveSelectedGroup(null);
+    if (trimmed) {
+      void this.refresh({ force: true });
+    } else {
+      emit();
+    }
+  },
+
+  removeAddon() {
+    this.setManifestUrl("");
+  },
+
+  selectGroup(groupId) {
+    state.selectedGroupId = groupId || null;
+    saveSelectedGroup(state.selectedGroupId);
+    emit();
+  },
+
+  setViewMode(mode) {
+    state.viewMode = mode === "OnNow" ? "OnNow" : "Guide";
+    LocalStore.set(KEY_VIEW_MODE, state.viewMode);
+    emit();
+  },
+
+  setOnNowSort(sort) {
+    state.onNowSort = ["Channel", "EndingSoon", "JustStarted"].includes(sort) ? sort : "Channel";
+    LocalStore.set(KEY_ON_NOW_SORT, state.onNowSort);
+    emit();
+  },
+
+  isFavorite(channelId) {
+    return state.favoriteIds.includes(channelId);
+  },
+
+  toggleFavorite(channelId) {
+    if (!channelId) return false;
+    const isFavorite = state.favoriteIds.includes(channelId);
+    state.favoriteIds = isFavorite
+      ? state.favoriteIds.filter((id) => id !== channelId)
+      : [...state.favoriteIds, channelId];
+    saveProfileIds(KEY_FAVORITES, state.favoriteIds);
+    if (state.selectedGroupId === LIVE_TV_FAVORITES_GROUP_ID && !state.favoriteIds.length) {
+      state.selectedGroupId = null;
+      saveSelectedGroup(null);
+    }
+    emit();
+    return !isFavorite;
+  },
+
+  recordWatched(channelId) {
+    if (!channelId) return;
+    state.recentIds = [channelId, ...state.recentIds.filter((id) => id !== channelId)].slice(
+      0,
+      LIVE_TV_MAX_RECENTS
+    );
+    saveProfileIds(KEY_RECENTS, state.recentIds);
+    emit();
+  },
+
+  clearFavorites() {
+    state.favoriteIds = [];
+    saveProfileIds(KEY_FAVORITES, []);
+    if (state.selectedGroupId === LIVE_TV_FAVORITES_GROUP_ID) {
+      state.selectedGroupId = null;
+      saveSelectedGroup(null);
+    }
+    emit();
+  },
+
+  clearRecents() {
+    state.recentIds = [];
+    saveProfileIds(KEY_RECENTS, []);
+    if (state.selectedGroupId === LIVE_TV_RECENT_GROUP_ID) {
+      state.selectedGroupId = null;
+      saveSelectedGroup(null);
+    }
+    emit();
+  },
+
+  /** The channel watched before the current one, for the "Last channel" button. */
+  previousChannelId(currentId = null) {
+    return state.recentIds.find((id) => id !== currentId) || null;
+  },
+
+  /** Channels for a chip, resolving the local Favorites and Recent chips. */
+  channelsFor(groupId = state.selectedGroupId) {
+    const guide = state.guide;
+    if (!guide) return [];
+    if (groupId === LIVE_TV_FAVORITES_GROUP_ID)
+      return state.favoriteIds.map((id) => guideChannel(guide, id)).filter(Boolean);
+    if (groupId === LIVE_TV_RECENT_GROUP_ID)
+      return state.recentIds.map((id) => guideChannel(guide, id)).filter(Boolean);
+    return guideChannelsFor(guide, groupId);
+  },
+
+  /** Channels for channel up/down inside a chip; falls back to the full lineup. */
+  channelsForSession(groupId) {
+    const channels = this.channelsFor(groupId);
+    return channels.length ? channels : guideLineup(state.guide);
+  },
+
+  /** Addon groups shown as chips (the addon's own favorites catalog is replaced by local Favorites). */
+  addonChips() {
+    return (state.guide?.groups || []).filter((group) => !isAddonFavoritesGroup(group));
+  },
+
+  workingStreams() {
+    const stored = LocalStore.get(KEY_WORKING_STREAMS, {});
+    return stored && typeof stored === "object" ? stored : {};
+  },
+
+  workingStreamFor(channelId) {
+    return this.workingStreams()[channelId] || null;
+  },
+
+  /** Called when a source has been playing for a while, so the next tune starts with it. */
+  rememberWorkingStream(channelId, stream) {
+    const url = String(stream?.url || "").trim() || null;
+    const label = streamLabelKey(stream) || null;
+    if (!channelId || (!url && !label)) return;
+    const current = this.workingStreams();
+    const existing = current[channelId];
+    if (existing && existing.url === url && existing.label === label) return;
+    const updated = { ...current, [channelId]: { url, label, savedAtMs: Date.now() } };
+    const trimmed = Object.entries(updated)
+      .sort((left, right) => Number(right[1]?.savedAtMs || 0) - Number(left[1]?.savedAtMs || 0))
+      .slice(0, LIVE_TV_MAX_REMEMBERED_STREAMS);
+    LocalStore.set(KEY_WORKING_STREAMS, Object.fromEntries(trimmed));
+  },
+
+  /** A channel's raw streams, ordered so the source that worked last time comes first. */
+  async loadStreams(channel) {
+    const streams = await loadChannelStreams(state.manifestUrl, channel, { fetchJson });
+    return orderStreamsByPreference(streams, this.workingStreamFor(channel.id));
+  }
+};
+
+function describeLoadError(error) {
+  const status = Number(error?.status || 0);
+  if (status === 404)
+    return "The addon link wasn't found (404). Check the link in Settings → Live TV.";
+  if (status) return `The addon answered with an error (${status}).`;
+  const message = String(error?.message || "").trim();
+  if (/abort|timeout/i.test(message))
+    return "The addon took too long to answer. Check your connection and try again.";
+  if (/failed to fetch|network/i.test(message) || !message)
+    return "Couldn't reach the addon. Check your connection and try again.";
+  return message.length > 160 ? `${message.slice(0, 157)}…` : message;
+}
diff --git a/js/livetv/liveTvSettings.js b/js/livetv/liveTvSettings.js
new file mode 100644
index 0000000000000000000000000000000000000000..514de3e4a5559813968c62d3f97641d823fa57c7
--- /dev/null
+++ b/js/livetv/liveTvSettings.js
@@ -0,0 +1,276 @@
+// Settings → Live TV: the addon link (typed on the TV or sent from a phone), guide
+// refresh, removing the addon, and clearing this profile's favorites and recents.
+// Rendered by the Settings screen with `this` bound to it.
+
+import { Router } from "../ui/navigation/routerState.js";
+import { LiveTvRepository } from "./liveTvRepository.js";
+import { isPlausibleManifestUrl } from "./liveTvGuide.js";
+import { startLiveTvPhoneEntry } from "./liveTvPhoneEntry.js";
+import { formatClock } from "./liveTvTime.js";
+import { escapeHtml } from "./ui/liveTvMarkup.js";
+
+export const LIVE_TV_SETTINGS_SECTION = {
+  id: "liveTv",
+  label: "Live TV",
+  subtitle: "Addon link, guide refresh, favorites"
+};
+
+function rerender(screen) {
+  if (Router.getCurrent() === "settings" && screen.activeSection === LIVE_TV_SETTINGS_SECTION.id) {
+    void screen.render({ refreshModel: false }).then(() => screen.applyFocus?.());
+  }
+}
+
+function watchRepository(screen) {
+  if (screen.liveTvSettingsUnsubscribe) return;
+  screen.liveTvSettingsUnsubscribe = LiveTvRepository.subscribe(() => {
+    if (Router.getCurrent() !== "settings") {
+      screen.liveTvSettingsUnsubscribe?.();
+      screen.liveTvSettingsUnsubscribe = null;
+      return;
+    }
+    // Don't redraw under an open dialog; it would steal the remote's focus.
+    if (!screen.textDialog && !screen.optionDialog) rerender(screen);
+  });
+}
+
+function openLinkDialog(screen) {
+  const state = LiveTvRepository.state;
+  screen.openTextDialog({
+    title: "Live TV addon link",
+    value: state.manifestUrl || "",
+    placeholder: "https://…/manifest.json",
+    returnFocusKey: "liveTv:link",
+    saveLabel: "Save",
+    clearLabel: state.manifestUrl ? "Remove" : "",
+    onClear: state.manifestUrl
+      ? () => {
+          LiveTvRepository.removeAddon();
+          return true;
+        }
+      : undefined,
+    onSubmit: (value) => {
+      const trimmed = String(value || "").trim();
+      if (!trimmed) {
+        if (screen.textDialog) screen.textDialog.statusMessage = "Type the addon's link first.";
+        return false;
+      }
+      if (!isPlausibleManifestUrl(trimmed)) {
+        if (screen.textDialog)
+          screen.textDialog.statusMessage =
+            "That doesn't look like a web link (for example https://example.com/manifest.json).";
+        return false;
+      }
+      LiveTvRepository.setManifestUrl(trimmed);
+      return true;
+    }
+  });
+}
+
+async function openPhoneDialog(screen) {
+  screen.closeLiveTvPhoneSession?.();
+  const showMessage = (html, options = [{ id: "close", label: "Close" }]) => {
+    screen.openOptionDialog({
+      title: "Set up with your phone",
+      messageHtml: html,
+      options,
+      selectedId: options[0].id,
+      returnFocusKey: "liveTv:phone",
+      dialogClassName: "ltv-phone-dialog",
+      onSelect: () => {
+        screen.closeLiveTvPhoneSession?.();
+      },
+      onClose: () => screen.closeLiveTvPhoneSession?.()
+    });
+  };
+  showMessage(`<p>Starting…</p>`);
+  rerender(screen);
+  try {
+    const session = await startLiveTvPhoneEntry({
+      currentLink: LiveTvRepository.state.manifestUrl,
+      onLink: (link) => {
+        if (!isPlausibleManifestUrl(link)) return;
+        LiveTvRepository.setManifestUrl(link);
+        screen.closeLiveTvPhoneSession?.();
+        showMessage(
+          `<p class="ltv-phone-done">Got it! The guide is loading from:</p><p class="ltv-phone-url">${escapeHtml(link)}</p>`,
+          [{ id: "close", label: "Done" }]
+        );
+        rerender(screen);
+      },
+      onExpired: () => {
+        screen.liveTvPhoneSession = null;
+      }
+    });
+    if (
+      Router.getCurrent() !== "settings" ||
+      screen.optionDialog?.returnFocusKey !== "liveTv:phone"
+    ) {
+      session.stop();
+      return;
+    }
+    screen.liveTvPhoneSession = session;
+    screen.closeLiveTvPhoneSession = () => {
+      screen.liveTvPhoneSession?.stop();
+      screen.liveTvPhoneSession = null;
+    };
+    showMessage(`
+      <div class="ltv-phone-qr-block">
+        <img class="ltv-phone-qr" src="${escapeHtml(session.qrDataUrl)}" alt="QR code" />
+        <div class="ltv-phone-steps">
+          <p>1. Make sure your phone is on the same Wi-Fi as this TV.</p>
+          <p>2. Scan the code with your phone's camera.</p>
+          <p>3. Type or paste the addon link and tap <b>Send to TV</b>.</p>
+          <p class="ltv-phone-url">${escapeHtml(session.url)}</p>
+        </div>
+      </div>`);
+    rerender(screen);
+  } catch (error) {
+    showMessage(
+      `<p>${escapeHtml(error?.message || "Phone setup isn't available right now.")}</p><p>You can type the link on the TV instead.</p>`
+    );
+    rerender(screen);
+  }
+}
+
+function confirm(screen, { title, message, confirmLabel, focusKey, onConfirm }) {
+  screen.openOptionDialog({
+    title,
+    message,
+    options: [
+      { id: "confirm", label: confirmLabel },
+      { id: "cancel", label: "Cancel" }
+    ],
+    selectedId: "cancel",
+    returnFocusKey: focusKey,
+    onSelect: (option) => {
+      if (option?.id === "confirm") onConfirm();
+    }
+  });
+}
+
+/** Runs an action requested from the Live TV screen (its setup buttons). */
+export function runLiveTvSettingsAction(screen, action) {
+  if (action === "phone") void openPhoneDialog(screen);
+  if (action === "type") openLinkDialog(screen);
+}
+
+export function renderLiveTvSettingsSection() {
+  watchRepository(this);
+  const state = LiveTvRepository.ensureLoaded();
+  const guide = state.guide;
+  const configured = LiveTvRepository.isConfigured();
+  const status = !configured
+    ? "No addon yet"
+    : guide
+      ? `${guide.addonName} · ${guide.lineupIds.length} channels · Updated ${formatClock(guide.loadedAtMs)}`
+      : state.isLoading
+        ? "Loading the guide…"
+        : state.errorMessage || "Not loaded yet";
+
+  this.actionMap.set("liveTv:link", () => openLinkDialog(this));
+  this.actionMap.set("liveTv:phone", () => openPhoneDialog(this));
+  this.actionMap.set("liveTv:refresh", () => {
+    void LiveTvRepository.refresh({ force: true });
+  });
+  this.actionMap.set("liveTv:open", () => {
+    Router.navigate("liveTv");
+  });
+  this.actionMap.set("liveTv:remove", () =>
+    confirm(this, {
+      title: "Remove addon?",
+      message: "Live TV will ask for an addon link again.",
+      confirmLabel: "Remove",
+      focusKey: "liveTv:remove",
+      onConfirm: () => LiveTvRepository.removeAddon()
+    })
+  );
+  this.actionMap.set("liveTv:clearFavorites", () =>
+    confirm(this, {
+      title: "Clear favorites?",
+      message: "This profile's starred channels will be removed.",
+      confirmLabel: "Clear",
+      focusKey: "liveTv:clearFavorites",
+      onConfirm: () => LiveTvRepository.clearFavorites()
+    })
+  );
+  this.actionMap.set("liveTv:clearRecents", () =>
+    confirm(this, {
+      title: "Clear recently watched?",
+      message: "This profile's recently watched channels will be removed.",
+      confirmLabel: "Clear",
+      focusKey: "liveTv:clearRecents",
+      onConfirm: () => LiveTvRepository.clearRecents()
+    })
+  );
+
+  const count = (ids) => `${ids.length} channel${ids.length === 1 ? "" : "s"}`;
+  return `
+    ${this.renderSectionHeader(LIVE_TV_SETTINGS_SECTION)}
+    <div class="settings-group-card">
+      <div class="settings-group-heading">
+        <div class="settings-group-title">Addon</div>
+        <div class="settings-group-subtitle">${escapeHtml(status)}</div>
+      </div>
+      <div class="settings-stack">
+        ${this.renderActionRow({
+          focusKey: "liveTv:phone",
+          title: "Set up with your phone",
+          subtitle: "Scan a QR code and type or paste the link on your phone",
+          leadingIcon: "qr_code_2"
+        })}
+        ${this.renderActionRow({
+          focusKey: "liveTv:link",
+          title: "Addon link",
+          subtitle: configured
+            ? state.manifestUrl
+            : "Type the manifest.json link of a Stremio addon with live channels",
+          value: configured ? "Change" : "Add",
+          leadingIcon: "link"
+        })}
+        ${
+          configured
+            ? `${this.renderActionRow({
+                focusKey: "liveTv:refresh",
+                title: "Refresh guide now",
+                subtitle: "The guide also refreshes itself every 30 minutes",
+                leadingIcon: "refresh"
+              })}
+              ${this.renderActionRow({
+                focusKey: "liveTv:open",
+                title: "Open Live TV",
+                leadingIcon: "live_tv"
+              })}
+              ${this.renderActionRow({
+                focusKey: "liveTv:remove",
+                title: "Remove addon",
+                subtitle: "Live TV will ask for an addon link again",
+                leadingIcon: "delete"
+              })}`
+            : ""
+        }
+      </div>
+    </div>
+    <div class="settings-group-card">
+      <div class="settings-group-heading">
+        <div class="settings-group-title">Your channels</div>
+        <div class="settings-group-subtitle">Favorites and recently watched are saved separately for each profile.</div>
+      </div>
+      <div class="settings-stack">
+        ${this.renderActionRow({
+          focusKey: "liveTv:clearFavorites",
+          title: "Clear favorites",
+          value: count(state.favoriteIds),
+          leadingIcon: "star_border",
+          disabled: !state.favoriteIds.length
+        })}
+        ${this.renderActionRow({
+          focusKey: "liveTv:clearRecents",
+          title: "Clear recently watched",
+          value: count(state.recentIds),
+          leadingIcon: "history",
+          disabled: !state.recentIds.length
+        })}
+      </div>
+    </div>`;
+}
