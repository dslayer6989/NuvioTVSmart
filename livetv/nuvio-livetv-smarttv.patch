+
+/** Live TV guide colors for any theme, including Custom colors and AMOLED black. */
+export function liveTvGuidePalette(themeName, colors) {
+  const special = SPECIAL_GUIDE_PALETTES[String(themeName || "").toUpperCase()];
+  if (special) return special;
+  const background = colors["--bg-color"] || "#0d0d0d";
+  const elevated = colors["--bg-elevated"] || "#1a1a1a";
+  const card = colors["--card-bg"] || "#222222";
+  const accent = colors["--secondary-color"] || "#f5f5f5";
+  const stops = gradientStops(colors["--accent-gradient"]);
+  const variant = colors["--secondary-variant"];
+  const highlight =
+    (distinct(variant, accent) && variant) ||
+    (stops.length && distinct(stops[stops.length - 1], accent) && stops[stops.length - 1]) ||
+    mix(accent, "#ffffff", 0.45);
+  const deep =
+    (stops.length && distinct(stops[0], accent) && stops[0]) || mix(accent, "#000000", 0.35);
+  const amoled = String(background).toLowerCase() === "#000000";
+  const surface = amoled ? "#080808" : mix(background, elevated, 0.6);
+  const raised = amoled ? "#141414" : card;
+  const textMuted = colors["--text-tertiary"] || "#808080";
+  const border = colors["--border-color"] || "#333333";
+  const gridCandidate = mix(background, border, 0.9);
+  const accentStops = stops.length >= 2 ? stops : [deep, accent, highlight];
+  return {
+    bg: background,
+    surface,
+    raised,
+    panel: rgba(elevated, 0.88),
+    grid: distinct(gridCandidate, background) ? gridCandidate : mix(background, textMuted, 0.18),
+    gridStrong: mix(background, textMuted, 0.32),
+    accent,
+    accentSoft: mix(accent, "#ffffff", 0.3),
+    highlight,
+    deep,
+    live: LIVE_RED,
+    onAccent: colors["--on-secondary"] || (luminance(accent) > 0.179 ? "#000000" : "#ffffff"),
+    text: colors["--text-color"] || "#ffffff",
+    text2: colors["--text-secondary"] || "#b3b3b3",
+    text3: textMuted,
+    past: mix(background, surface, 0.45),
+    future: mix(raised, accent, 0.04),
+    airing: mix(raised, accent, 0.16),
+    accentGradient: linear("90deg", accentStops),
+    airingGradient: linear("90deg", [mix(raised, accent, 0.2), mix(raised, highlight, 0.16)]),
+    screenGradient: linear("180deg", [
+      mix(background, surface, 0.5),
+      background,
+      mix(background, "#000000", 0.35)
+    ]),
+    nowGradient: linear("180deg", [accent, highlight]),
+    progressGradient: linear("90deg", [accent, highlight]),
+    logoTile: linear("135deg", [mix(raised, accent, 0.06), surface])
+  };
+}
+
+const GUIDE_VARIABLES = {
+  bg: "--ltv-bg",
+  surface: "--ltv-surface",
+  raised: "--ltv-raised",
+  panel: "--ltv-panel",
+  grid: "--ltv-grid",
+  gridStrong: "--ltv-grid-strong",
+  accent: "--ltv-accent",
+  accentSoft: "--ltv-accent-soft",
+  highlight: "--ltv-highlight",
+  deep: "--ltv-deep",
+  live: "--ltv-live",
+  onAccent: "--ltv-on-accent",
+  text: "--ltv-text",
+  text2: "--ltv-text-2",
+  text3: "--ltv-text-3",
+  past: "--ltv-past",
+  future: "--ltv-future",
+  airing: "--ltv-airing",
+  accentGradient: "--ltv-accent-gradient",
+  airingGradient: "--ltv-airing-gradient",
+  screenGradient: "--ltv-screen-gradient",
+  nowGradient: "--ltv-now-gradient",
+  progressGradient: "--ltv-progress-gradient",
+  logoTile: "--ltv-logo-tile"
+};
+
+const BASE_CARD_RADIUS_PX = 16;
+
+/**
+ * Applies the Live TV colors and the theme's style touches. Called by ThemeManager.apply()
+ * after the regular palette is written.
+ */
+export function applyLiveTvTheme(themeName, colors, root = globalThis.document?.documentElement) {
+  if (!root?.style) return;
+  const guide = liveTvGuidePalette(themeName, colors);
+  Object.entries(GUIDE_VARIABLES).forEach(([key, variable]) => {
+    root.style.setProperty(variable, guide[key]);
+  });
+  const style = liveTvThemeStyle(themeName);
+  const heading = style.heading ? FONT_FACES[style.heading] : null;
+  const label = style.label ? FONT_FACES[style.label] : null;
+  root.style.setProperty("--ltv-corner-scale", String(style.cornerScale));
+  root.style.setProperty("--ltv-heading-font", heading ? heading.family : "var(--app-font-family)");
+  root.style.setProperty("--ltv-heading-scale", String(heading ? heading.scale : 1));
+  root.style.setProperty("--ltv-label-font", label ? label.family : "var(--app-font-family)");
+  root.style.setProperty("--ltv-label-scale", String(label ? label.scale : 1));
+  const isLiveTvTheme = LIVE_TV_THEME_IDS.includes(String(themeName || "").toUpperCase());
+  if (isLiveTvTheme) {
+    // Corners follow the theme across the app, like the desktop build.
+    root.style.setProperty(
+      "--tv-card-radius",
+      `${Math.round(BASE_CARD_RADIUS_PX * style.cornerScale)}px`
+    );
+  } else {
+    root.style.removeProperty("--tv-card-radius");
+  }
+  const classes = root.classList;
+  classes?.toggle("ltv-glow", Boolean(style.glow));
+  classes?.toggle("ltv-scanlines", Boolean(style.scanlines));
+  classes?.toggle("ltv-theme-heading-font", Boolean(heading));
+  classes?.toggle("ltv-theme-label-font", Boolean(label));
+  classes?.toggle("ltv-theme", isLiveTvTheme);
+}
diff --git a/js/livetv/liveTvTime.js b/js/livetv/liveTvTime.js
new file mode 100644
index 0000000000000000000000000000000000000000..2e5cdbf31a54b37f105a2830bd899f9c2fb6e99f
--- /dev/null
+++ b/js/livetv/liveTvTime.js
@@ -0,0 +1,169 @@
+// Pure time helpers for the Live TV guide. All values are epoch milliseconds (UTC).
+
+export const MINUTE_MS = 60 * 1000;
+export const HALF_HOUR_MS = 30 * MINUTE_MS;
+export const HOUR_MS = 60 * MINUTE_MS;
+export const DAY_MS = 24 * HOUR_MS;
+
+export function floorToHalfHour(epochMs) {
+  return Math.floor(epochMs / HALF_HOUR_MS) * HALF_HOUR_MS;
+}
+
+/** Half-hour slot starts covering [startMs, endMs). */
+export function halfHourSlots(startMs, endMs) {
+  const slots = [];
+  for (let cursor = floorToHalfHour(startMs); cursor < endMs; cursor += HALF_HOUR_MS) {
+    slots.push(cursor);
+  }
+  return slots;
+}
+
+function pad(value, length = 2) {
+  return String(value).padStart(length, "0");
+}
+
+/** "YYYY-MM-DD" for the UTC day containing epochMs. */
+export function utcDate(epochMs) {
+  const date = new Date(Math.floor(epochMs / DAY_MS) * DAY_MS);
+  return `${pad(date.getUTCFullYear(), 4)}-${pad(date.getUTCMonth() + 1)}-${pad(date.getUTCDate())}`;
+}
+
+/** Every UTC date touched by [startMs, endMs]. */
+export function utcDatesBetween(startMs, endMs) {
+  if (endMs < startMs) return [];
+  const dates = [];
+  for (let day = Math.floor(startMs / DAY_MS); day <= Math.floor(endMs / DAY_MS); day += 1) {
+    dates.push(utcDate(day * DAY_MS));
+  }
+  return dates;
+}
+
+const ISO_PATTERN =
+  /^(\d{4})-(\d{2})-(\d{2})(?:[Tt ](\d{2}):(\d{2})(?::(\d{2})(?:[.,](\d{1,9}))?)?)?\s*(Z|z|[+-]\d{2}(?::?\d{2})?)?$/;
+const XMLTV_PATTERN = /^(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})(\d{2})?\s*([+-]\d{4})?$/;
+
+function parseOffset(raw) {
+  if (!raw || raw.toLowerCase() === "z") return 0;
+  const sign = raw.startsWith("-") ? -1 : 1;
+  const digits = raw.slice(1).replace(":", "");
+  const hours = Number(digits.slice(0, 2));
+  const minutes = digits.length > 2 ? Number(digits.slice(2)) : 0;
+  if (!Number.isFinite(hours) || !Number.isFinite(minutes) || hours > 18 || minutes > 59)
+    return null;
+  return sign * (hours * HOUR_MS + minutes * MINUTE_MS);
+}
+
+function toEpochMs(year, month, day, hour, minute, second, millis, offsetMs) {
+  if (month < 1 || month > 12 || day < 1 || day > 31 || hour > 23 || minute > 59 || second > 60) {
+    return null;
+  }
+  return Date.UTC(year, month - 1, day, hour, minute, second, millis) - offsetMs;
+}
+
+/** Parses ISO-8601 instants ("2026-09-29T20:00:00Z", offsets, fractions) and XMLTV stamps. */
+export function parseInstant(value) {
+  const text = String(value ?? "").trim();
+  if (!text) return null;
+  let match = ISO_PATTERN.exec(text);
+  if (match) {
+    const offsetMs = parseOffset(match[8] || "");
+    if (offsetMs == null) return null;
+    const fraction = match[7] ? Number(match[7].padEnd(3, "0").slice(0, 3)) : 0;
+    return toEpochMs(
+      Number(match[1]),
+      Number(match[2]),
+      Number(match[3]),
+      Number(match[4] || 0),
+      Number(match[5] || 0),
+      Number(match[6] || 0),
+      fraction,
+      offsetMs
+    );
+  }
+  match = XMLTV_PATTERN.exec(text);
+  if (match) {
+    const offsetMs = parseOffset(match[7] || "");
+    if (offsetMs == null) return null;
+    return toEpochMs(
+      Number(match[1]),
+      Number(match[2]),
+      Number(match[3]),
+      Number(match[4]),
+      Number(match[5]),
+      Number(match[6] || 0),
+      0,
+      offsetMs
+    );
+  }
+  return null;
+}
+
+/** "60 min", "1h 30m", "1:30", "PT1H30M" or a bare number of minutes. */
+export function parseRuntimeMinutes(value) {
+  const text = String(value ?? "")
+    .trim()
+    .toLowerCase();
+  if (!text) return null;
+  if (/^\d+$/.test(text)) {
+    const minutes = Number(text);
+    return minutes > 0 ? minutes : null;
+  }
+  let match = /^(\d+):(\d{2})$/.exec(text);
+  if (match) {
+    const total = Number(match[1]) * 60 + Number(match[2]);
+    return total > 0 ? total : null;
+  }
+  match = /^pt(?:(\d+)h)?(?:(\d+)m)?(?:\d+s)?$/.exec(text);
+  if (match) {
+    const total = Number(match[1] || 0) * 60 + Number(match[2] || 0);
+    return total > 0 ? total : null;
+  }
+  const hours = Number(/(\d+)\s*(?:h|hr|hrs|hour|hours)\b/.exec(text)?.[1] || 0);
+  const minutes = Number(/(\d+)\s*(?:m|min|mins|minute|minutes)\b/.exec(text)?.[1] || 0);
+  const total = hours * 60 + minutes;
+  return total > 0 ? total : null;
+}
+
+/** "9:30 PM" style clock text in the TV's local time zone. */
+export function formatClock(epochMs) {
+  const date = new Date(epochMs);
+  const hours = date.getHours();
+  const minutes = date.getMinutes();
+  const hour12 = hours % 12 === 0 ? 12 : hours % 12;
+  return `${hour12}:${pad(minutes)} ${hours < 12 ? "AM" : "PM"}`;
+}
+
+/** "Today", "Tomorrow" or a short weekday + date, for the guide's day label. */
+export function formatDayLabel(epochMs, nowMs = Date.now()) {
+  const date = new Date(epochMs);
+  const today = new Date(nowMs);
+  const startOfDay = (value) =>
+    new Date(value.getFullYear(), value.getMonth(), value.getDate()).getTime();
+  const dayDelta = Math.round((startOfDay(date) - startOfDay(today)) / DAY_MS);
+  if (dayDelta === 0) return "Today";
+  if (dayDelta === 1) return "Tomorrow";
+  if (dayDelta === -1) return "Yesterday";
+  const weekdays = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
+  const months = [
+    "Jan",
+    "Feb",
+    "Mar",
+    "Apr",
+    "May",
+    "Jun",
+    "Jul",
+    "Aug",
+    "Sep",
+    "Oct",
+    "Nov",
+    "Dec"
+  ];
+  return `${weekdays[date.getDay()]} ${months[date.getMonth()]} ${date.getDate()}`;
+}
+
+/** "45 min" or "1h 20m" for a remaining duration. */
+export function formatDuration(ms) {
+  const totalMinutes = Math.max(1, Math.round(ms / MINUTE_MS));
+  if (totalMinutes < 60) return `${totalMinutes} min`;
+  return `${Math.floor(totalMinutes / 60)}h ${totalMinutes % 60}m`;
+}
diff --git a/js/livetv/ui/liveTvDomPatch.js b/js/livetv/ui/liveTvDomPatch.js
new file mode 100644
index 0000000000000000000000000000000000000000..26a23363b6db655cd2147ba65b0f65cc25f9c345
--- /dev/null
+++ b/js/livetv/ui/liveTvDomPatch.js
@@ -0,0 +1,75 @@
+// Updates a region from new HTML but keeps every child whose markup didn't change, so a
+// remote key press only redraws the few guide rows it touched (no logo flicker, less work
+// for older TVs). Children are matched by `data-ltv-key`; containers marked
+// `data-ltv-deep` are patched the same way one level further down.
+
+function keyOf(node) {
+  return node?.dataset?.ltvKey || "";
+}
+
+/** Remembers the markup a node was built from (and, for deep containers, its children's). */
+function stamp(node) {
+  node.__ltvHtml = node.outerHTML;
+  if (node.hasAttribute?.("data-ltv-deep")) Array.from(node.children).forEach(stamp);
+}
+
+function syncAttributes(target, source) {
+  Array.from(target.attributes).forEach((attribute) => {
+    if (!source.hasAttribute(attribute.name)) target.removeAttribute(attribute.name);
+  });
+  Array.from(source.attributes).forEach((attribute) => {
+    if (target.getAttribute(attribute.name) !== attribute.value)
+      target.setAttribute(attribute.name, attribute.value);
+  });
+}
+
+function patchChildren(parent, nextParent) {
+  const previous = new Map();
+  Array.from(parent.children).forEach((child) => {
+    const key = keyOf(child);
+    if (key) previous.set(key, child);
+  });
+  const result = Array.from(nextParent.children).map((next) => {
+    const key = keyOf(next);
+    const old = key ? previous.get(key) : null;
+    if (!old) {
+      stamp(next);
+      return next;
+    }
+    previous.delete(key);
+    const html = next.outerHTML;
+    if (old.__ltvHtml === html) return old;
+    if (next.hasAttribute("data-ltv-deep") && old.hasAttribute("data-ltv-deep")) {
+      syncAttributes(old, next);
+      patchChildren(old, next);
+      old.__ltvHtml = html;
+      return old;
+    }
+    stamp(next);
+    return next;
+  });
+  // Put the children in order, moving kept nodes instead of recreating them.
+  result.forEach((node, index) => {
+    const current = parent.children[index];
+    if (current !== node) parent.insertBefore(node, current || null);
+  });
+  while (parent.children.length > result.length) parent.removeChild(parent.lastElementChild);
+}
+
+export function patchRegion(container, html) {
+  if (!container) return;
+  if (container.__ltvRegionHtml === html) return;
+  container.__ltvRegionHtml = html;
+  const template = document.createElement("div");
+  template.innerHTML = html;
+  const allKeyed = Array.from(template.children).every((child) => keyOf(child));
+  if (!allKeyed || !container.children.length) {
+    container.innerHTML = "";
+    Array.from(template.children).forEach((child) => {
+      stamp(child);
+      container.appendChild(child);
+    });
+    return;
+  }
+  patchChildren(container, template);
+}
diff --git a/js/livetv/ui/liveTvGuideView.js b/js/livetv/ui/liveTvGuideView.js
new file mode 100644
index 0000000000000000000000000000000000000000..be26d458c1c00b8e833f723184eb9287de9932e1
--- /dev/null
+++ b/js/livetv/ui/liveTvGuideView.js
@@ -0,0 +1,230 @@
+// The program guide grid: a channel column, a half-hour time bar and programme cells.
+// Only the rows and the time span on screen are drawn, so even 2019 TVs stay smooth.
+
+import { escapeHtml, liveBadge, logoTile, progressBar, starIcon } from "./liveTvMarkup.js";
+import { guidePrograms, programProgress } from "../liveTvGuide.js";
+import { HALF_HOUR_MS, formatClock, formatDayLabel } from "../liveTvTime.js";
+
+export const GUIDE_ROW_HEIGHT_PX = 84;
+export const GUIDE_CHANNEL_COLUMN_PX = 300;
+export const GUIDE_HALF_HOUR_PX = 300;
+export const GUIDE_TIME_BAR_PX = 48;
+const PX_PER_MS = GUIDE_HALF_HOUR_PX / HALF_HOUR_MS;
+
+export function msToPx(ms) {
+  return ms * PX_PER_MS;
+}
+
+export function pxToMs(px) {
+  return px / PX_PER_MS;
+}
+
+/** The programmes a row can focus, limited to the guide window. Channels without data get one "no guide" cell. */
+export function rowCells(guide, channel, window) {
+  const programs = guidePrograms(guide, channel.id).filter(
+    (program) => program.endMs > window.startMs && program.startMs < window.endMs
+  );
+  if (programs.length) return programs;
+  return [
+    {
+      id: `nodata:${channel.id}`,
+      channelId: channel.id,
+      title: "No guide information",
+      startMs: window.startMs,
+      endMs: window.endMs,
+      noData: true
+    }
+  ];
+}
+
+/** Index of the cell airing at `timeMs`, or the closest one. */
+export function cellIndexAt(cells, timeMs) {
+  if (!cells.length) return -1;
+  const airing = cells.findIndex((cell) => timeMs >= cell.startMs && timeMs < cell.endMs);
+  if (airing >= 0) return airing;
+  let best = 0;
+  let bestDistance = Infinity;
+  cells.forEach((cell, index) => {
+    const distance = timeMs < cell.startMs ? cell.startMs - timeMs : timeMs - cell.endMs;
+    if (distance < bestDistance) {
+      bestDistance = distance;
+      best = index;
+    }
+  });
+  return best;
+}
+
+function cellState(cell, nowMs) {
+  if (cell.noData) return "nodata";
+  if (nowMs >= cell.endMs) return "past";
+  if (nowMs >= cell.startMs) return "airing";
+  return "future";
+}
+
+function renderTimeBar(view, nowMs, dayLabel) {
+  const slots = [];
+  const nowInView = nowMs >= view.startMs && nowMs < view.endMs;
+  for (let slot = view.startMs; slot < view.endMs; slot += HALF_HOUR_MS) {
+    // The "now" pill already shows the time; don't let a slot label sit under it.
+    if (nowInView && slot > nowMs - pxToMs(110) && slot < nowMs + pxToMs(70)) continue;
+    slots.push(
+      `<span class="ltv-time-slot" style="left:${Math.round(msToPx(slot - view.startMs))}px">${escapeHtml(formatClock(slot))}</span>`
+    );
+  }
+  return `
+    <div class="ltv-time-bar" data-ltv-key="timebar" style="height:${GUIDE_TIME_BAR_PX}px">
+      <div class="ltv-time-day" style="width:${GUIDE_CHANNEL_COLUMN_PX}px">${escapeHtml(dayLabel)}</div>
+      <div class="ltv-time-track">
+        ${slots.join("")}
+        ${
+          nowInView
+            ? `<span class="ltv-time-now" style="left:${Math.round(msToPx(nowMs - view.startMs))}px">${escapeHtml(formatClock(nowMs))}</span>`
+            : ""
+        }
+      </div>
+    </div>`;
+}
+
+function renderChannelCell(channel, { focused, favorite, tuning }) {
+  return `
+    <div class="ltv-channel-cell focusable${focused ? " focused" : ""}"
+         data-ltv-zone="channel" data-ltv-channel-id="${escapeHtml(channel.id)}" tabindex="-1"
+         style="width:${GUIDE_CHANNEL_COLUMN_PX}px">
+      ${logoTile(channel, "ltv-channel-logo")}
+      <span class="ltv-channel-copy">
+        <span class="ltv-channel-number">${channel.number ? escapeHtml(String(channel.number)) : ""}</span>
+        <span class="ltv-channel-name">${escapeHtml(channel.name)}</span>
+        ${tuning ? `<span class="ltv-channel-tuning">Tuning…</span>` : ""}
+      </span>
+      ${favorite ? starIcon(true) : ""}
+    </div>`;
+}
+
+function renderProgramCell(cell, view, nowMs, { focused, rowIndex, cellIndex }) {
+  const visibleStart = Math.max(cell.startMs, view.startMs);
+  const visibleEnd = Math.min(cell.endMs, view.endMs);
+  if (visibleEnd <= visibleStart) return "";
+  const left = Math.round(msToPx(visibleStart - view.startMs));
+  const width = Math.max(8, Math.round(msToPx(visibleEnd - visibleStart)) - 4);
+  const state = cellState(cell, nowMs);
+  const continues = cell.startMs < view.startMs;
+  const time = cell.noData ? "" : `${formatClock(cell.startMs)} – ${formatClock(cell.endMs)}`;
+  return `
+    <div class="ltv-program-cell is-${state}${focused ? " focused" : ""}${continues ? " continues" : ""} focusable"
+         data-ltv-zone="grid" data-ltv-row="${rowIndex}" data-ltv-cell="${cellIndex}" tabindex="-1"
+         style="left:${left}px;width:${width}px">
+      <span class="ltv-program-title">${continues ? "‹ " : ""}${escapeHtml(cell.title)}</span>
+      ${time && width > 150 ? `<span class="ltv-program-time">${escapeHtml(time)}</span>` : ""}
+      ${state === "airing" ? progressBar(programProgress(cell, nowMs), "ltv-program-progress") : ""}
+    </div>`;
+}
+
+/**
+ * @param {object} options
+ * @param {object} options.guide
+ * @param {Array} options.channels  channels of the selected chip
+ * @param {{startMs:number,endMs:number}} options.view  visible time span
+ * @param {number} options.topRow  first row on screen
+ * @param {number} options.visibleRows
+ * @param {object} options.focus  { zone: "grid" | "channel" | other, row, cell }
+ */
+export function renderGuideGrid({
+  guide,
+  channels,
+  window,
+  view,
+  topRow,
+  visibleRows,
+  nowMs,
+  focus,
+  favorites,
+  tuningChannelId
+}) {
+  const rows = [];
+  const lastRow = Math.min(channels.length, topRow + visibleRows);
+  for (let rowIndex = topRow; rowIndex < lastRow; rowIndex += 1) {
+    const channel = channels[rowIndex];
+    const cells = rowCells(guide, channel, window);
+    const rowFocused = focus.row === rowIndex;
+    const programHtml = cells
+      .map((cell, cellIndex) =>
+        renderProgramCell(cell, view, nowMs, {
+          focused: rowFocused && focus.zone === "grid" && focus.cell === cellIndex,
+          rowIndex,
+          cellIndex
+        })
+      )
+      .join("");
+    rows.push(`
+      <div class="ltv-guide-row${rowFocused ? " is-focused-row" : ""}" style="height:${GUIDE_ROW_HEIGHT_PX}px" data-ltv-row="${rowIndex}"
+           data-ltv-key="row:${escapeHtml(channel.id)}">
+        ${renderChannelCell(channel, {
+          focused: rowFocused && focus.zone === "channel",
+          favorite: favorites.has(channel.id),
+          tuning: tuningChannelId === channel.id
+        })}
+        <div class="ltv-program-track">${programHtml}</div>
+      </div>`);
+  }
+  const nowInView = nowMs >= view.startMs && nowMs < view.endMs;
+  const nowLeft = GUIDE_CHANNEL_COLUMN_PX + Math.round(msToPx(nowMs - view.startMs));
+  const canScrollUp = topRow > 0;
+  const canScrollDown = lastRow < channels.length;
+  return `
+    ${renderTimeBar(view, nowMs, formatDayLabel(Math.max(view.startMs, nowMs), nowMs))}
+    <div class="ltv-guide-body" data-ltv-key="body" data-ltv-deep="1">
+      ${rows.join("")}
+      ${nowInView ? `<span class="ltv-now-line" data-ltv-key="now" style="left:${nowLeft}px"></span>` : ""}
+      ${canScrollUp ? `<span class="ltv-scroll-hint is-up" data-ltv-key="hint-up" aria-hidden="true">▲</span>` : ""}
+      ${canScrollDown ? `<span class="ltv-scroll-hint is-down" data-ltv-key="hint-down" aria-hidden="true">▼</span>` : ""}
+    </div>`;
+}
+
+/** Details for the focused programme (or channel) above the grid. */
+export function renderGuideDetails({ channel, program, nowMs, favorite, tuning }) {
+  if (!channel) return `<div class="ltv-details is-empty" data-ltv-key="details"></div>`;
+  const airing = program && !program.noData && nowMs >= program.startMs && nowMs < program.endMs;
+  const future = program && !program.noData && program.startMs > nowMs;
+  const meta = [];
+  if (program && !program.noData) {
+    meta.push(`${formatClock(program.startMs)} – ${formatClock(program.endMs)}`);
+    if (airing) {
+      const minutes = Math.max(1, Math.round((program.endMs - nowMs) / 60000));
+      meta.push(
+        minutes >= 60
+          ? `Ends in ${Math.floor(minutes / 60)}h ${minutes % 60}m`
+          : `Ends in ${minutes} min`
+      );
+    } else if (future) {
+      meta.push(`${formatDayLabel(program.startMs, nowMs)}`);
+    }
+  }
+  meta.push(`${channel.number ? `${channel.number} · ` : ""}${channel.name}`);
+  const action = tuning
+    ? "Tuning…"
+    : future
+      ? "Starts later · OK watches the channel now"
+      : "OK to watch";
+  return `
+    <div class="ltv-details" data-ltv-key="details">
+      ${logoTile(channel, "ltv-details-logo")}
+      <div class="ltv-details-copy">
+        <div class="ltv-details-title-row">
+          ${airing ? liveBadge() : ""}
+          <span class="ltv-details-title">${escapeHtml(program?.title || channel.name)}</span>
+          ${favorite ? starIcon(true) : ""}
+        </div>
+        <div class="ltv-details-meta">${escapeHtml(meta.join("  ·  "))}</div>
+        ${
+          program?.description
+            ? `<div class="ltv-details-description">${escapeHtml(program.description)}</div>`
+            : `<div class="ltv-details-description is-muted">${escapeHtml(channel.description || "")}</div>`
+        }
+      </div>
+      <div class="ltv-details-hints">
+        <span class="ltv-hint">${escapeHtml(action)}</span>
+        <span class="ltv-hint">Hold OK · channel options</span>
+        <span class="ltv-hint"><span class="ltv-key-dot is-red"></span>Favorite <span class="ltv-key-dot is-yellow"></span>−2h <span class="ltv-key-dot is-blue"></span>+2h</span>
+      </div>
+    </div>`;
+}
diff --git a/js/livetv/ui/liveTvMarkup.js b/js/livetv/ui/liveTvMarkup.js
new file mode 100644
index 0000000000000000000000000000000000000000..1cdb89cc5e6dff07e5dd9d6dda47910b6725911a
--- /dev/null
+++ b/js/livetv/ui/liveTvMarkup.js
@@ -0,0 +1,53 @@
+// Small HTML builders shared by the Live TV guide, On Now, the Home row and the player.
+
+export function escapeHtml(value) {
+  return String(value ?? "")
+    .replace(/&/g, "&amp;")
+    .replace(/</g, "&lt;")
+    .replace(/>/g, "&gt;")
+    .replace(/"/g, "&quot;")
+    .replace(/'/g, "&#39;");
+}
+
+export function monogram(name) {
+  const words = String(name || "")
+    .replace(/[^A-Za-z0-9\u00C0-\u024F ]/g, " ")
+    .trim()
+    .split(/\s+/)
+    .filter(Boolean);
+  if (!words.length) return "TV";
+  if (words.length === 1) return words[0].slice(0, 3).toUpperCase();
+  return words
+    .slice(0, 3)
+    .map((word) => word[0])
+    .join("")
+    .toUpperCase();
+}
+
+/** Channel logo on a tile, falling back to the channel's initials if the image fails. */
+export function logoTile(channel, className = "") {
+  const name = channel?.name || "";
+  const logo = String(channel?.logo || "").trim();
+  return `<span class="ltv-logo-tile${className ? ` ${className}` : ""}" aria-hidden="true">
+      <span class="ltv-logo-monogram">${escapeHtml(monogram(name))}</span>
+      ${
+        logo
+          ? `<img class="ltv-logo-image" src="${escapeHtml(logo)}" alt="" loading="lazy" onerror="this.remove()" onload="this.parentNode&&this.parentNode.classList.add('has-logo')" />`
+          : ""
+      }
+    </span>`;
+}
+
+export function liveBadge(label = "LIVE") {
+  return `<span class="ltv-live-badge"><span class="ltv-live-dot"></span>${escapeHtml(label)}</span>`;
+}
+
+export function progressBar(fraction, className = "") {
+  // Whole percents keep the markup stable between key presses, so rows can be reused.
+  const percent = Math.round(Math.max(0, Math.min(1, Number(fraction) || 0)) * 100);
+  return `<span class="ltv-progress${className ? ` ${className}` : ""}"><span class="ltv-progress-fill" style="width:${percent}%"></span></span>`;
+}
+
+export function starIcon(filled = true) {
+  return `<span class="ltv-star${filled ? " is-filled" : ""}" aria-hidden="true">${filled ? "★" : "☆"}</span>`;
+}
diff --git a/js/livetv/ui/liveTvOnNowView.js b/js/livetv/ui/liveTvOnNowView.js
new file mode 100644
index 0000000000000000000000000000000000000000..402a4c439ad8d77d4c28057cf74d962a44117bf3
--- /dev/null
+++ b/js/livetv/ui/liveTvOnNowView.js
@@ -0,0 +1,100 @@
+// "On Now": a card for every channel showing what's airing, how long is left and what's next.
+
+import { escapeHtml, liveBadge, logoTile, progressBar, starIcon } from "./liveTvMarkup.js";
+import { programProgress } from "../liveTvGuide.js";
+import { formatClock, formatDuration } from "../liveTvTime.js";
+
+export const ON_NOW_COLUMNS = 4;
+export const ON_NOW_CARD_HEIGHT_PX = 216;
+export const ON_NOW_SORT_OPTIONS = [
+  { id: "Channel", label: "Channel order" },
+  { id: "EndingSoon", label: "Ending soon" },
+  { id: "JustStarted", label: "Just started" }
+];
+
+export function renderOnNowSortRow(selectedSort, focusedIndex) {
+  return `
+    <div class="ltv-sort-row" data-ltv-key="sort" role="toolbar" aria-label="Sort">
+      <span class="ltv-sort-label">Sort</span>
+      ${ON_NOW_SORT_OPTIONS.map(
+        (option, index) => `
+        <button class="ltv-pill focusable${option.id === selectedSort ? " is-selected" : ""}${focusedIndex === index ? " focused" : ""}"
+                data-ltv-zone="sort" data-ltv-index="${index}" tabindex="-1">${escapeHtml(option.label)}</button>`
+      ).join("")}
+    </div>`;
+}
+
+export function renderRecentStrip(channels, focusedIndex) {
+  if (!channels.length) return "";
+  return `
+    <div class="ltv-recent-strip" data-ltv-key="recents">
+      <span class="ltv-recent-label">Recently watched</span>
+      ${channels
+        .map(
+          (channel, index) => `
+        <button class="ltv-recent-item focusable${focusedIndex === index ? " focused" : ""}"
+                data-ltv-zone="recents" data-ltv-index="${index}" tabindex="-1" aria-label="${escapeHtml(channel.name)}">
+          ${logoTile(channel, "ltv-recent-logo")}
+        </button>`
+        )
+        .join("")}
+    </div>`;
+}
+
+function renderCard(entry, index, { focused, favorite, tuning, nowMs }) {
+  const { channel, current, next } = entry;
+  return `
+    <div class="ltv-onnow-card focusable${focused ? " focused" : ""}" data-ltv-zone="cards" data-ltv-index="${index}" tabindex="-1"
+         data-ltv-key="card:${escapeHtml(channel.id)}">
+      <div class="ltv-onnow-top">
+        ${logoTile(channel, "ltv-onnow-logo")}
+        <div class="ltv-onnow-channel">
+          <span class="ltv-onnow-number">${channel.number ? escapeHtml(String(channel.number)) : ""}</span>
+          <span class="ltv-onnow-name">${escapeHtml(channel.name)}</span>
+        </div>
+        ${favorite ? starIcon(true) : ""}
+        ${current ? liveBadge() : ""}
+      </div>
+      <div class="ltv-onnow-title">${escapeHtml(tuning ? "Tuning…" : current?.title || "No guide information")}</div>
+      ${
+        current
+          ? `${progressBar(programProgress(current, nowMs), "ltv-onnow-progress")}
+             <div class="ltv-onnow-meta">Ends in ${escapeHtml(formatDuration(current.endMs - nowMs))}</div>`
+          : `<div class="ltv-onnow-meta">&nbsp;</div>`
+      }
+      <div class="ltv-onnow-next">${next ? `Up next · ${escapeHtml(formatClock(next.startMs))} ${escapeHtml(next.title)}` : "&nbsp;"}</div>
+    </div>`;
+}
+
+export function renderOnNowCards({
+  entries,
+  topRow,
+  visibleRows,
+  focusedIndex,
+  favorites,
+  tuningChannelId,
+  nowMs
+}) {
+  const start = topRow * ON_NOW_COLUMNS;
+  const end = Math.min(entries.length, (topRow + visibleRows) * ON_NOW_COLUMNS);
+  const cards = [];
+  for (let index = start; index < end; index += 1) {
+    const entry = entries[index];
+    cards.push(
+      renderCard(entry, index, {
+        focused: focusedIndex === index,
+        favorite: favorites.has(entry.channel.id),
+        tuning: tuningChannelId === entry.channel.id,
+        nowMs
+      })
+    );
+  }
+  const canScrollUp = topRow > 0;
+  const canScrollDown = end < entries.length;
+  return `
+    <div class="ltv-onnow-grid" data-ltv-key="grid" data-ltv-deep="1">
+      ${cards.join("")}
+      ${canScrollUp ? `<span class="ltv-scroll-hint is-up" data-ltv-key="hint-up" aria-hidden="true">▲</span>` : ""}
+      ${canScrollDown ? `<span class="ltv-scroll-hint is-down" data-ltv-key="hint-down" aria-hidden="true">▼</span>` : ""}
+    </div>`;
+}
diff --git a/js/livetv/ui/liveTvScreen.js b/js/livetv/ui/liveTvScreen.js
new file mode 100644
index 0000000000000000000000000000000000000000..c63f26f8e56fed844efc99dcbdcc88549ff3b935
--- /dev/null
+++ b/js/livetv/ui/liveTvScreen.js
@@ -0,0 +1,1288 @@
+// The Live TV screen: program guide and On Now views, category chips, favorites,
+// recently watched and a channel options menu. Every control works with the remote's
+// arrows, OK and Back; colour and channel keys are shortcuts on top.
+
+import { Router } from "../../ui/navigation/routerState.js";
+import { ScreenUtils } from "../../ui/navigation/screen.js";
+import { LayoutPreferences } from "../../data/local/layoutPreferences.js";
+import { Platform } from "../../platform/index.js";
+import { allowDpadRepeat, resetDpadRepeat } from "../../ui/navigation/dpadRepeatThrottle.js";
+import {
+  activateLegacySidebarAction,
+  bindRootSidebarEvents,
+  focusWithoutAutoScroll,
+  getRootSidebarNodes,
+  getRootSidebarSelectedNode,
+  getSidebarProfileState,
+  isRootSidebarNode,
+  isSelectedSidebarAction,
+  renderRootSidebar,
+  setLegacySidebarExpanded,
+  setModernSidebarExpanded,
+  setModernSidebarPillIconOnly
+} from "../../ui/components/sidebarNavigation.js";
+import {
+  LIVE_TV_FAVORITES_GROUP_ID,
+  LIVE_TV_RECENT_GROUP_ID,
+  LiveTvRepository
+} from "../liveTvRepository.js";
+import { LiveTvPlayback } from "../liveTvPlayback.js";
+import { guideChannel, guideWindow, onNowEntries, programAt } from "../liveTvGuide.js";
+import { HALF_HOUR_MS, HOUR_MS, floorToHalfHour, formatClock } from "../liveTvTime.js";
+import { escapeHtml, liveBadge } from "./liveTvMarkup.js";
+import { patchRegion } from "./liveTvDomPatch.js";
+import {
+  GUIDE_CHANNEL_COLUMN_PX,
+  GUIDE_ROW_HEIGHT_PX,
+  GUIDE_TIME_BAR_PX,
+  cellIndexAt,
+  pxToMs,
+  renderGuideDetails,
+  renderGuideGrid,
+  rowCells
+} from "./liveTvGuideView.js";
+import {
+  ON_NOW_CARD_HEIGHT_PX,
+  ON_NOW_COLUMNS,
+  ON_NOW_SORT_OPTIONS,
+  renderOnNowCards,
+  renderOnNowSortRow,
+  renderRecentStrip
+} from "./liveTvOnNowView.js";
+
+export const LIVE_TV_ROUTE = "liveTv";
+
+const LONG_PRESS_MS = 600;
+const TICK_MS = 30 * 1000;
+const RECENT_STRIP_LIMIT = 10;
+const TIME_JUMP_MS = 2 * HOUR_MS;
+const DETAILS_BLOCK_PX = 182;
+
+const KEY = {
+  LEFT: 37,
+  UP: 38,
+  RIGHT: 39,
+  DOWN: 40,
+  ENTER: 13,
+  PAGE_UP: 33,
+  PAGE_DOWN: 34,
+  CHANNEL_UP: 427,
+  CHANNEL_DOWN: 428,
+  RED: 403,
+  GREEN: 404,
+  YELLOW: 405,
+  BLUE: 406,
+  F: 70,
+  G: 71
+};
+
+const HEADER_ACTIONS = [
+  { id: "viewGuide", label: "Guide", icon: "grid_view" },
+  { id: "viewOnNow", label: "On Now", icon: "live_tv" },
+  { id: "lastChannel", label: "Last channel", icon: "history" },
+  { id: "refresh", label: "Refresh", icon: "refresh" },
+  { id: "settings", label: "Settings", icon: "settings" }
+];
+
+function keyCodeOf(event) {
+  return Number(event?.keyCode || 0);
+}
+
+function isLongPressCapable(zone) {
+  return zone === "grid" || zone === "channel" || zone === "cards" || zone === "recents";
+}
+
+function clamp(value, min, max) {
+  return Math.max(min, Math.min(max, value));
+}
+
+export const LiveTvScreen = {
+  ui: null,
+
+  resetUi() {
+    this.ui = {
+      zone: "content",
+      headerIndex: 0,
+      chipIndex: 0,
+      sortIndex: 0,
+      recentIndex: 0,
+      stateIndex: 0,
+      row: 0,
+      cell: 0,
+      cursorTimeMs: Date.now(),
+      topRow: 0,
+      viewStartMs: null,
+      cardIndex: 0,
+      cardTopRow: 0,
+      lastContentZone: "grid"
+    };
+  },
+
+  async mount(params = {}, navigationContext = {}) {
+    this.container = document.getElementById(LIVE_TV_ROUTE);
+    ScreenUtils.show(this.container);
+    this.layoutPrefs = LayoutPreferences.get();
+    this.mountToken = (this.mountToken || 0) + 1;
+    const mountToken = this.mountToken;
+    if (!this.ui || !navigationContext?.isBackNavigation) this.resetUi();
+    this.menu = null;
+    this.pendingEnter = null;
+    this.sidebarExpanded = false;
+    this.pillIconOnly = false;
+    this.focusZone = "content";
+    this.routeEnterPending = true;
+    try {
+      this.sidebarProfile = await getSidebarProfileState({ cacheOnly: true });
+    } catch (_) {
+      this.sidebarProfile = null;
+    }
+    if (mountToken !== this.mountToken) return;
+    LiveTvRepository.ensureLoaded();
+    this.unsubscribe?.();
+    this.unsubscribe = LiveTvRepository.subscribe(() => this.onRepositoryChange());
+    this.unsubscribeTuning?.();
+    this.unsubscribeTuning = LiveTvPlayback.onTuningChange(() =>
+      this.renderContent({ keepFocus: true })
+    );
+    this.renderShell();
+    this.renderContent();
+    clearInterval(this.tickTimer);
+    this.tickTimer = setInterval(() => this.onTick(), TICK_MS);
+    void getSidebarProfileState()
+      .then((profile) => {
+        if (profile && mountToken === this.mountToken && Router.getCurrent() === LIVE_TV_ROUTE)
+          this.sidebarProfile = profile;
+      })
+      .catch(() => {});
+    if (params?.jumpToNow) this.jumpToNow();
+  },
+
+  cleanup() {
+    this.mountToken = (this.mountToken || 0) + 1;
+    clearInterval(this.tickTimer);
+    this.tickTimer = null;
+    this.unsubscribe?.();
+    this.unsubscribe = null;
+    this.unsubscribeTuning?.();
+    this.unsubscribeTuning = null;
+    this.menu = null;
+    this.pendingEnter = null;
+    resetDpadRepeat(this);
+    ScreenUtils.hide(this.container);
+  },
+
+  onRepositoryChange() {
+    if (Router.getCurrent() !== LIVE_TV_ROUTE) return;
+    this.renderContent({ keepFocus: true });
+  },
+
+  onTick() {
+    if (Router.getCurrent() !== LIVE_TV_ROUTE) return;
+    LiveTvRepository.refreshIfStale();
+    this.renderContent({ keepFocus: true });
+  },
+
+  onSidebarReselect() {
+    this.jumpToNow();
+  },
+
+  get state() {
+    return LiveTvRepository.state;
+  },
+
+  // --- Layout -----------------------------------------------------------------------
+
+  renderShell() {
+    const enterClass = ScreenUtils.routeEnterClass(
+      this,
+      this.routeEnterPending,
+      " nuvio-route-slide-enter"
+    );
+    this.routeEnterPending = false;
+    this.container.innerHTML = `
+      <div class="home-shell livetv-shell${this.layoutPrefs?.modernSidebar ? " has-modern-sidebar" : ""}">
+        ${renderRootSidebar({
+          selectedRoute: LIVE_TV_ROUTE,
+          profile: this.sidebarProfile,
+          layout: this.layoutPrefs,
+          expanded: Boolean(this.sidebarExpanded),
+          pillIconOnly: Boolean(this.pillIconOnly)
+        })}
+        <main class="home-main livetv-main${enterClass}">
+          <header class="ltv-header" id="ltvHeader"></header>
+          <nav class="ltv-chips" id="ltvChips" aria-label="Channel categories"></nav>
+          <section class="ltv-body" id="ltvBody"></section>
+          <div class="ltv-menu-layer" id="ltvMenu"></div>
+        </main>
+      </div>`;
+    bindRootSidebarEvents(this.container, {
+      currentRoute: LIVE_TV_ROUTE,
+      onSelectedAction: () => this.closeSidebarToContent(),
+      onExpandSidebar: () => this.openSidebar()
+    });
+    this.bindPointerEvents();
+  },
+
+  chips() {
+    const state = this.state;
+    const chips = [{ id: null, label: "All channels" }];
+    if (state.favoriteIds.length)
+      chips.push({ id: LIVE_TV_FAVORITES_GROUP_ID, label: "★ Favorites" });
+    if (state.recentIds.length) chips.push({ id: LIVE_TV_RECENT_GROUP_ID, label: "Recent" });
+    LiveTvRepository.addonChips().forEach((group) =>
+      chips.push({ id: group.id, label: group.name })
+    );
+    return chips;
+  },
+
+  status() {
+    const state = this.state;
+    if (!LiveTvRepository.isConfigured()) return "setup";
+    if (state.guide) return "ready";
+    if (state.errorMessage) return "error";
+    return "loading";
+  },
+
+  stateButtons() {
+    const status = this.status();
+    if (status === "setup") {
+      return [
+        { id: "setupPhone", label: "Set up with your phone", icon: "qr_code_2" },
+        { id: "setupType", label: "Type the link", icon: "keyboard" }
+      ];
+    }
+    if (status === "error") {
+      return [
+        { id: "retry", label: "Try again", icon: "refresh" },
+        { id: "settings", label: "Live TV settings", icon: "settings" }
+      ];
+    }
+    return [];
+  },
+
+  visibleChannels() {
+    return LiveTvRepository.channelsFor(this.state.selectedGroupId);
+  },
+
+  isOnNow() {
+    return this.state.viewMode === "OnNow";
+  },
+
+  /** Zones the arrows can reach right now, top to bottom. */
+  verticalZones() {
+    const status = this.status();
+    const zones = ["header"];
+    if (status !== "ready") {
+      if (this.stateButtons().length) zones.push("state");
+      return zones;
+    }
+    zones.push("chips");
+    if (!this.visibleChannels().length) return zones;
+    if (this.isOnNow()) {
+      zones.push("sort");
+      if (this.recentChannels().length) zones.push("recents");
+      zones.push("cards");
+    } else {
+      zones.push("grid");
+    }
+    return zones;
+  },
+
+  recentChannels() {
+    const guide = this.state.guide;
+    return this.state.recentIds
+      .map((id) => guideChannel(guide, id))
+      .filter(Boolean)
+      .slice(0, RECENT_STRIP_LIMIT);
+  },
+
+  headerActions() {
+    return HEADER_ACTIONS.filter((action) => {
+      if (this.status() !== "ready") return action.id === "settings" || action.id === "refresh";
+      if (action.id === "lastChannel") return Boolean(LiveTvRepository.previousChannelId(null));
+      return true;
+    });
+  },
+
+  renderHeader() {
+    const header = this.container?.querySelector("#ltvHeader");
+    if (!header) return;
+    const state = this.state;
+    const guide = state.guide;
+    const actions = this.headerActions();
+    this.ui.headerIndex = clamp(this.ui.headerIndex, 0, Math.max(0, actions.length - 1));
+    const statusText = guide
+      ? `${guide.addonName} · ${guide.lineupIds.length} channels${state.isRefreshing ? " · Refreshing…" : ` · Updated ${formatClock(guide.loadedAtMs)}`}`
+      : state.isLoading
+        ? "Loading the guide…"
+        : "";
+    patchRegion(
+      header,
+      `
+      <div class="ltv-title-block" data-ltv-key="title">
+        <h1 class="ltv-title">${liveBadge("LIVE")}<span class="ltv-title-text">Live TV</span></h1>
+        <div class="ltv-subtitle">${escapeHtml(statusText)}</div>
+      </div>
+      <div class="ltv-actions" role="toolbar" data-ltv-key="actions" data-ltv-deep="1">
+        ${actions
+          .map((action, index) => {
+            const selected =
+              (action.id === "viewGuide" && !this.isOnNow()) ||
+              (action.id === "viewOnNow" && this.isOnNow());
+            const focused =
+              this.focusZone === "content" &&
+              this.ui.zone === "header" &&
+              this.ui.headerIndex === index;
+            return `
+            <button class="ltv-action focusable${selected ? " is-selected" : ""}${focused ? " focused" : ""}"
+                    data-ltv-zone="header" data-ltv-index="${index}" data-ltv-action="${action.id}" tabindex="-1"
+                    data-ltv-key="action:${action.id}">
+              <span class="material-icons ltv-action-icon" aria-hidden="true">${action.icon}</span>
+              <span class="ltv-action-label">${escapeHtml(action.label)}</span>
+            </button>`;
+          })
+          .join("")}
+      </div>`
+    );
+  },
+
+  renderChips() {
+    const nav = this.container?.querySelector("#ltvChips");
+    if (!nav) return;
+    if (this.status() !== "ready") {
+      patchRegion(nav, "");
+      nav.classList.add("is-hidden");
+      return;
+    }
+    nav.classList.remove("is-hidden");
+    const chips = this.chips();
+    const selectedIndex = Math.max(
+      0,
+      chips.findIndex((chip) => chip.id === (this.state.selectedGroupId || null))
+    );
+    if (this.ui.zone !== "chips") this.ui.chipIndex = selectedIndex;
+    this.ui.chipIndex = clamp(this.ui.chipIndex, 0, chips.length - 1);
+    patchRegion(
+      nav,
+      `
+      <div class="ltv-chip-track" id="ltvChipTrack" data-ltv-key="track" data-ltv-deep="1">
+        ${chips
+          .map((chip, index) => {
+            const focused =
+              this.focusZone === "content" &&
+              this.ui.zone === "chips" &&
+              this.ui.chipIndex === index;
+            return `
+            <button class="ltv-pill ltv-chip focusable${index === selectedIndex ? " is-selected" : ""}${focused ? " focused" : ""}"
+                    data-ltv-zone="chips" data-ltv-index="${index}" tabindex="-1"
+                    data-ltv-key="chip:${escapeHtml(chip.id || "all")}">${escapeHtml(chip.label)}</button>`;
+          })
+          .join("")}
+      </div>`
+    );
+    this.scrollChipIntoView();
+  },
+
+  scrollChipIntoView() {
+    const nav = this.container?.querySelector("#ltvChips");
+    const track = nav?.querySelector("#ltvChipTrack");
+    const chip = track?.querySelector(`[data-ltv-index="${this.ui.chipIndex}"]`);
+    if (!nav || !track || !chip) return;
+    const navWidth = nav.clientWidth;
+    const chipLeft = chip.offsetLeft;
+    const chipRight = chipLeft + chip.offsetWidth;
+    let offset = this.chipOffset || 0;
+    if (chipRight - offset > navWidth - 24) offset = chipRight - navWidth + 24;
+    if (chipLeft - offset < 0) offset = Math.max(0, chipLeft - 24);
+    this.chipOffset = offset;
+    track.style.transform = `translateX(${-offset}px)`;
+  },
+
+  renderStatePanel() {
+    const status = this.status();
+    const buttons = this.stateButtons();
+    this.ui.stateIndex = clamp(this.ui.stateIndex, 0, Math.max(0, buttons.length - 1));
+    const buttonHtml = buttons
+      .map((button, index) => {
+        const focused =
+          this.focusZone === "content" && this.ui.zone === "state" && this.ui.stateIndex === index;
+        return `
+        <button class="ltv-state-button focusable${focused ? " focused" : ""}" data-ltv-zone="state" data-ltv-index="${index}"
+                data-ltv-action="${button.id}" tabindex="-1">
+          <span class="material-icons" aria-hidden="true">${button.icon}</span>
+          <span>${escapeHtml(button.label)}</span>
+        </button>`;
+      })
+      .join("");
+    if (status === "setup") {
+      return `
+        <div class="ltv-state-panel is-setup">
+          <div class="ltv-state-icon material-icons" aria-hidden="true">live_tv</div>
+          <h2 class="ltv-state-title">Set up Live TV</h2>
+          <p class="ltv-state-message">Add the link of a Stremio addon with live channels. Its program guide loads automatically.</p>
+          <p class="ltv-state-message is-small">The easiest way: scan a QR code with your phone and type or paste the link there.</p>
+          <div class="ltv-state-buttons">${buttonHtml}</div>
+        </div>`;
+    }
+    if (status === "error") {
+      return `
+        <div class="ltv-state-panel is-error">
+          <div class="ltv-state-icon material-icons" aria-hidden="true">signal_cellular_connected_no_internet_4_bar</div>
+          <h2 class="ltv-state-title">Couldn't load Live TV</h2>
+          <p class="ltv-state-message">${escapeHtml(this.state.errorMessage)}</p>
+          <div class="ltv-state-buttons">${buttonHtml}</div>
+        </div>`;
+    }
+    return `
+      <div class="ltv-state-panel is-loading">
+        <div class="ltv-spinner" aria-hidden="true"></div>
+        <p class="ltv-state-message">Loading the guide…</p>
+      </div>`;
+  },
+
+  renderEmptyGroup() {
+    const isFavorites = this.state.selectedGroupId === LIVE_TV_FAVORITES_GROUP_ID;
+    return `
+      <div class="ltv-state-panel is-empty">
+        <h2 class="ltv-state-title">${isFavorites ? "No favorites yet" : "No channels here yet"}</h2>
+        <p class="ltv-state-message">${
+          isFavorites
+            ? "Star a channel to pin it here: hold OK on a channel, or press the red button."
+            : "Pick another category above."
+        }</p>
+      </div>`;
+  },
+
+  /** Re-renders everything below the sidebar. Focus follows `this.ui`. */
+  renderContent({ keepFocus = false } = {}) {
+    if (!this.container?.querySelector("#ltvBody")) return;
+    void keepFocus;
+    this.normalizeZone();
+    this.renderHeader();
+    this.renderChips();
+    const body = this.container.querySelector("#ltvBody");
+    const status = this.status();
+    body.classList.toggle("is-onnow", status === "ready" && this.isOnNow());
+    body.classList.toggle("is-guide", status === "ready" && !this.isOnNow());
+    if (status !== "ready") {
+      patchRegion(body, this.renderStatePanel());
+    } else if (!this.visibleChannels().length) {
+      patchRegion(body, this.renderEmptyGroup());
+    } else if (this.isOnNow()) {
+      this.renderOnNow(body);
+    } else {
+      this.renderGuide(body);
+    }
+    this.renderMenu();
+    this.applyDomFocus();
+  },
+
+  normalizeZone() {
+    if (this.focusZone !== "content") return;
+    const zones = this.verticalZones();
+    const zone = this.ui.zone === "channel" ? "grid" : this.ui.zone;
+    if (!zones.includes(zone)) {
+      const preferred = zones.includes(this.ui.lastContentZone) ? this.ui.lastContentZone : null;
+      this.ui.zone =
+        preferred ||
+        (zones.includes("state")
+          ? "state"
+          : zones.includes("grid")
+            ? "grid"
+            : zones.includes("cards")
+              ? "cards"
+              : zones[zones.length - 1]);
+    }
+  },
+
+  // --- Guide ------------------------------------------------------------------------
+
+  guideMetrics(body) {
+    const width = Math.max(600, (body?.clientWidth || 1500) - GUIDE_CHANNEL_COLUMN_PX);
+    // The details panel (168px + 14px gap) and the guide's border sit above the rows.
+    const height = Math.max(
+      GUIDE_ROW_HEIGHT_PX * 3,
+      (body?.clientHeight || 820) - DETAILS_BLOCK_PX - GUIDE_TIME_BAR_PX - 4
+    );
+    return {
+      spanMs: pxToMs(width),
+      visibleRows: Math.max(3, Math.floor(height / GUIDE_ROW_HEIGHT_PX))
+    };
+  },
+
+  ensureGuideView(body) {
+    const nowMs = Date.now();
+    const guide = this.state.guide;
+    const window = guideWindow(guide, nowMs);
+    const channels = this.visibleChannels();
+    const { spanMs, visibleRows } = this.guideMetrics(body);
+    this.guideVisibleRows = visibleRows;
+    const maxStart = Math.max(window.startMs, window.endMs - spanMs);
+    if (this.ui.viewStartMs == null) this.ui.viewStartMs = floorToHalfHour(nowMs) - HALF_HOUR_MS;
+    this.ui.viewStartMs = clamp(this.ui.viewStartMs, window.startMs, maxStart);
+    this.ui.row = clamp(this.ui.row, 0, channels.length - 1);
+    const cells = rowCells(guide, channels[this.ui.row], window);
+    if (
+      this.ui.cell >= cells.length ||
+      this.ui.cellRow !== this.ui.row ||
+      this.ui.cellChannelId !== channels[this.ui.row].id
+    ) {
+      this.ui.cell = cellIndexAt(cells, this.ui.cursorTimeMs);
+    }
+    this.ui.cell = clamp(this.ui.cell, 0, cells.length - 1);
+    this.ui.cellRow = this.ui.row;
+    this.ui.cellChannelId = channels[this.ui.row].id;
+    // Keep the focused row on screen.
+    if (this.ui.row < this.ui.topRow) this.ui.topRow = this.ui.row;
+    if (this.ui.row >= this.ui.topRow + visibleRows) this.ui.topRow = this.ui.row - visibleRows + 1;
+    this.ui.topRow = clamp(this.ui.topRow, 0, Math.max(0, channels.length - visibleRows));
+    return { nowMs, guide, window, channels, spanMs, visibleRows, cells };
+  },
+
+  /** Scrolls the time span so the focused programme's start (or the cursor) is visible. */
+  scrollViewToCell(cell, window, spanMs) {
+    const start = this.ui.viewStartMs;
+    const end = start + spanMs;
+    const margin = HALF_HOUR_MS / 2;
+    let next = start;
+    const focusTime = Math.max(cell.startMs, window.startMs);
+    if (focusTime < start) next = floorToHalfHour(focusTime);
+    else if (focusTime > end - margin) next = floorToHalfHour(focusTime) - HALF_HOUR_MS;
+    const maxStart = Math.max(window.startMs, window.endMs - spanMs);
+    this.ui.viewStartMs = clamp(next, window.startMs, maxStart);
+  },
+
+  renderGuide(body) {
+    const { nowMs, guide, window, channels, spanMs, visibleRows, cells } =
+      this.ensureGuideView(body);
+    const view = { startMs: this.ui.viewStartMs, endMs: this.ui.viewStartMs + spanMs };
+    const focusedChannel = channels[this.ui.row];
+    const focusedCell = cells[this.ui.cell];
+    const inGrid =
+      this.focusZone === "content" && (this.ui.zone === "grid" || this.ui.zone === "channel");
+    const detailsProgram =
+      this.ui.zone === "channel"
+        ? programAt(guide, focusedChannel.id, nowMs) || focusedCell
+        : focusedCell;
+    const favorites = new Set(this.state.favoriteIds);
+    patchRegion(
+      body,
+      `
+      ${renderGuideDetails({
+        channel: focusedChannel,
+        program: detailsProgram,
+        nowMs,
+        favorite: favorites.has(focusedChannel.id),
+        tuning: LiveTvPlayback.tuningChannelId === focusedChannel.id
+      })}
+      <div class="ltv-guide" id="ltvGuide" data-ltv-key="guide" data-ltv-deep="1">
+        ${renderGuideGrid({
+          guide,
+          channels,
+          window,
+          view,
+          topRow: this.ui.topRow,
+          visibleRows,
+          nowMs,
+          focus: { zone: inGrid ? this.ui.zone : "", row: this.ui.row, cell: this.ui.cell },
+          favorites,
+          tuningChannelId: LiveTvPlayback.tuningChannelId
+        })}
+      </div>`
+    );
+  },
+
+  moveGuideRow(delta, { page = false } = {}) {
+    const channels = this.visibleChannels();
+    if (!channels.length) return;
+    const step = page ? Math.max(1, (this.guideVisibleRows || 6) - 1) : 1;
+    const next = this.ui.row + delta * step;
+    if (next < 0) {
+      if (page) {
+        this.ui.row = 0;
+      } else {
+        this.setZone(this.previousZone("grid"));
+        return;
+      }
+    } else if (next > channels.length - 1) {
+      if (!page) return;
+      this.ui.row = channels.length - 1;
+    } else {
+      this.ui.row = next;
+    }
+    if (page)
+      this.ui.topRow = clamp(
+        this.ui.topRow + delta * step,
+        0,
+        Math.max(0, channels.length - (this.guideVisibleRows || 6))
+      );
+    this.ui.cellRow = -1; // re-pick the programme at the cursor time on the new row
+  },
+
+  moveGuideCell(delta) {
+    const body = this.container.querySelector("#ltvBody");
+    const { window, channels, spanMs } = this.ensureGuideView(body);
+    const cells = rowCells(this.state.guide, channels[this.ui.row], window);
+    const next = this.ui.cell + delta;
+    if (next < 0) {
+      // Nothing earlier in the guide window: the channel column is next.
+      this.ui.zone = "channel";
+      return;
+    }
+    if (next >= cells.length) {
+      // Past the last programme: scroll later if the window allows it.
+      const maxStart = Math.max(window.startMs, window.endMs - spanMs);
+      this.ui.viewStartMs = clamp(this.ui.viewStartMs + HALF_HOUR_MS, window.startMs, maxStart);
+      return;
+    }
+    this.ui.cell = next;
+    const cell = cells[next];
+    this.scrollViewToCell(cell, window, spanMs);
+    this.ui.cursorTimeMs = Math.max(cell.startMs, this.ui.viewStartMs);
+  },
+
+  shiftGuideTime(deltaMs) {
+    const body = this.container.querySelector("#ltvBody");
+    const { window, channels, spanMs } = this.ensureGuideView(body);
+    const maxStart = Math.max(window.startMs, window.endMs - spanMs);
+    this.ui.viewStartMs = clamp(
+      floorToHalfHour(this.ui.viewStartMs + deltaMs),
+      window.startMs,
+      maxStart
+    );
+    this.ui.cursorTimeMs = this.ui.viewStartMs + Math.min(spanMs / 3, HOUR_MS);
+    const cells = rowCells(this.state.guide, channels[this.ui.row], window);
+    this.ui.cell = cellIndexAt(cells, this.ui.cursorTimeMs);
+  },
+
+  jumpToNow() {
+    if (!this.ui) return;
+    const nowMs = Date.now();
+    this.ui.viewStartMs = floorToHalfHour(nowMs) - HALF_HOUR_MS;
+    this.ui.cursorTimeMs = nowMs;
+    this.ui.cellRow = -1;
+    if (Router.getCurrent() === LIVE_TV_ROUTE && this.container?.querySelector("#ltvBody"))
+      this.renderContent();
+  },
+
+  // --- On Now -----------------------------------------------------------------------
+
+  onNowEntries() {
+    return onNowEntries(this.state.guide, this.visibleChannels(), Date.now(), this.state.onNowSort);
+  },
+
+  renderOnNow(body) {
+    const entries = this.onNowEntries();
+    const recents = this.recentChannels();
+    this.ui.sortIndex = clamp(this.ui.sortIndex, 0, ON_NOW_SORT_OPTIONS.length - 1);
+    this.ui.recentIndex = clamp(this.ui.recentIndex, 0, Math.max(0, recents.length - 1));
+    this.ui.cardIndex = clamp(this.ui.cardIndex, 0, Math.max(0, entries.length - 1));
+    const zone = this.focusZone === "content" ? this.ui.zone : "";
+    // The sort row (64px) and the recently watched strip (92px) sit above the cards.
+    const toolbarHeight = 64 + (recents.length ? 92 : 0);
+    const visibleRows = Math.max(
+      1,
+      Math.floor(((body.clientHeight || 820) - toolbarHeight) / ON_NOW_CARD_HEIGHT_PX)
+    );
+    this.onNowVisibleRows = visibleRows;
+    const focusedRow = Math.floor(this.ui.cardIndex / ON_NOW_COLUMNS);
+    if (focusedRow < this.ui.cardTopRow) this.ui.cardTopRow = focusedRow;
+    if (focusedRow >= this.ui.cardTopRow + visibleRows)
+      this.ui.cardTopRow = focusedRow - visibleRows + 1;
+    const totalRows = Math.ceil(entries.length / ON_NOW_COLUMNS);
+    this.ui.cardTopRow = clamp(this.ui.cardTopRow, 0, Math.max(0, totalRows - visibleRows));
+    patchRegion(
+      body,
+      `
+      <div class="ltv-onnow-toolbar" data-ltv-key="toolbar" data-ltv-deep="1">
+        ${renderOnNowSortRow(this.state.onNowSort, zone === "sort" ? this.ui.sortIndex : -1)}
+        ${renderRecentStrip(recents, zone === "recents" ? this.ui.recentIndex : -1)}
+      </div>
+      <div class="ltv-onnow" id="ltvOnNow" data-ltv-key="onnow" data-ltv-deep="1">
+        ${renderOnNowCards({
+          entries,
+          topRow: this.ui.cardTopRow,
+          visibleRows,
+          focusedIndex: zone === "cards" ? this.ui.cardIndex : -1,
+          favorites: new Set(this.state.favoriteIds),
+          tuningChannelId: LiveTvPlayback.tuningChannelId,
+          nowMs: Date.now()
+        })}
+      </div>`
+    );
+  },
+
+  // --- Channel options menu ---------------------------------------------------------
+
+  openChannelMenu(channelId) {
+    const channel = guideChannel(this.state.guide, channelId);
+    if (!channel) return;
+    this.menu = { channelId, index: 0 };
+    this.renderMenu();
+    this.applyDomFocus();
+  },
+
+  menuOptions() {
+    if (!this.menu) return [];
+    const favorite = LiveTvRepository.isFavorite(this.menu.channelId);
+    return [
+      { id: "watch", label: "Watch now", icon: "play_arrow" },
+      {
+        id: "favorite",
+        label: favorite ? "Remove from favorites" : "Add to favorites",
+        icon: favorite ? "star" : "star_border"
+      },
+      { id: "close", label: "Cancel", icon: "close" }
+    ];
+  },
+
+  renderMenu() {
+    const layer = this.container?.querySelector("#ltvMenu");
+    if (!layer) return;
+    if (!this.menu) {
+      layer.innerHTML = "";
+      layer.classList.remove("is-open");
+      return;
+    }
+    const channel = guideChannel(this.state.guide, this.menu.channelId);
+    const program = programAt(this.state.guide, this.menu.channelId, Date.now());
+    const options = this.menuOptions();
+    this.menu.index = clamp(this.menu.index, 0, options.length - 1);
+    layer.classList.add("is-open");
+    layer.innerHTML = `
+      <div class="ltv-menu" role="dialog" aria-label="${escapeHtml(channel?.name || "Channel")}">
+        <div class="ltv-menu-title">${channel?.number ? `${channel.number} · ` : ""}${escapeHtml(channel?.name || "")}</div>
+        <div class="ltv-menu-subtitle">${escapeHtml(program?.title || "")}</div>
+        ${options
+          .map(
+            (option, index) => `
+          <button class="ltv-menu-option focusable${index === this.menu.index ? " focused" : ""}" data-ltv-zone="menu"
+                  data-ltv-index="${index}" tabindex="-1">
+            <span class="material-icons" aria-hidden="true">${option.icon}</span>
+            <span>${escapeHtml(option.label)}</span>
+          </button>`
+          )
+          .join("")}
+      </div>`;
+  },
+
+  closeMenu() {
+    this.menu = null;
+    this.renderContent({ keepFocus: true });
+  },
+
+  activateMenu() {
+    const option = this.menuOptions()[this.menu?.index || 0];
+    const channelId = this.menu?.channelId;
+    if (!option || !channelId) return;
+    if (option.id === "watch") {
+      this.menu = null;
+      this.renderMenu();
+      void this.playChannel(channelId);
+      return;
+    }
+    if (option.id === "favorite") {
+      LiveTvRepository.toggleFavorite(channelId);
+    }
+    this.closeMenu();
+  },
+
+  // --- Focus ------------------------------------------------------------------------
+
+  applyDomFocus() {
+    if (!this.container || this.focusZone !== "content") return;
+    let target = null;
+    if (this.menu) {
+      target = this.container.querySelector(".ltv-menu-option.focused");
+    } else {
+      target = this.container.querySelector(
+        "#ltvHeader .focused, #ltvChips .focused, #ltvBody .focused"
+      );
+    }
+    if (!target) return;
+    this.container
+      .querySelectorAll(
+        ".home-sidebar .focusable.focused, .modern-sidebar-panel .focusable.focused"
+      )
+      .forEach((node) => {
+        node.classList.remove("focused");
+      });
+    focusWithoutAutoScroll(target);
+  },
+
+  setZone(zone) {
+    if (!zone) return;
+    if (zone === "grid" || zone === "cards") this.ui.lastContentZone = zone;
+    this.ui.zone = zone;
+  },
+
+  previousZone(zone) {
+    const zones = this.verticalZones();
+    const index = zones.indexOf(zone);
+    return index > 0 ? zones[index - 1] : null;
+  },
+
+  nextZone(zone) {
+    const zones = this.verticalZones();
+    const index = zones.indexOf(zone);
+    return index >= 0 && index < zones.length - 1 ? zones[index + 1] : null;
+  },
+
+  // --- Sidebar ----------------------------------------------------------------------
+
+  focusSidebarNode(preferredNode = null) {
+    const nodes = getRootSidebarNodes(this.container, this.layoutPrefs);
+    const target =
+      preferredNode ||
+      getRootSidebarSelectedNode(this.container, this.layoutPrefs) ||
+      nodes[0] ||
+      null;
+    if (!target) return false;
+    this.container.querySelectorAll(".focusable.focused").forEach((node) => {
+      if (node !== target) node.classList.remove("focused");
+    });
+    target.classList.add("focused");
+    focusWithoutAutoScroll(target);
+    this.focusZone = "sidebar";
+    return true;
+  },
+
+  openSidebar() {
+    this.focusZone = "sidebar";
+    if (this.layoutPrefs?.modernSidebar && !this.sidebarExpanded) {
+      this.sidebarExpanded = true;
+      setModernSidebarExpanded(this.container, true);
+    } else if (!this.layoutPrefs?.modernSidebar) {
+      setLegacySidebarExpanded(this.container, true);
+    }
+    this.renderContent();
+    return this.focusSidebarNode();
+  },
+
+  closeSidebarToContent() {
+    this.focusZone = "content";
+    if (this.layoutPrefs?.modernSidebar && this.sidebarExpanded) {
+      this.sidebarExpanded = false;
+      setModernSidebarExpanded(this.container, false);
+    } else if (!this.layoutPrefs?.modernSidebar) {
+      setLegacySidebarExpanded(this.container, false);
+    }
+    this.renderContent();
+    return true;
+  },
+
+  // --- Actions ----------------------------------------------------------------------
+
+  async playChannel(channelId) {
+    const groupId = this.state.selectedGroupId;
+    await LiveTvPlayback.play(channelId, { groupId });
+  },
+
+  focusedChannelId() {
+    const zone = this.ui.zone;
+    if (zone === "grid" || zone === "channel")
+      return this.visibleChannels()[this.ui.row]?.id || null;
+    if (zone === "cards") return this.onNowEntries()[this.ui.cardIndex]?.channel?.id || null;
+    if (zone === "recents") return this.recentChannels()[this.ui.recentIndex]?.id || null;
+    return null;
+  },
+
+  activateHeader(actionId) {
+    if (actionId === "viewGuide") {
+      LiveTvRepository.setViewMode("Guide");
+    } else if (actionId === "viewOnNow") {
+      LiveTvRepository.setViewMode("OnNow");
+    } else if (actionId === "lastChannel") {
+      const channelId = LiveTvRepository.previousChannelId(null);
+      if (channelId) void this.playChannel(channelId);
+    } else if (actionId === "refresh") {
+      void LiveTvRepository.refresh({ force: true });
+    } else if (actionId === "settings") {
+      Router.navigate("settings", { section: "liveTv" });
+    } else if (actionId === "setupPhone") {
+      Router.navigate("settings", { section: "liveTv", liveTvAction: "phone" });
+    } else if (actionId === "setupType") {
+      Router.navigate("settings", { section: "liveTv", liveTvAction: "type" });
+    } else if (actionId === "retry") {
+      void LiveTvRepository.refresh({ force: true });
+    }
+  },
+
+  selectChip(index) {
+    const chip = this.chips()[index];
+    if (!chip) return;
+    this.ui.chipIndex = index;
+    if ((chip.id || null) !== (this.state.selectedGroupId || null)) {
+      this.ui.row = 0;
+      this.ui.topRow = 0;
+      this.ui.cardIndex = 0;
+      this.ui.cardTopRow = 0;
+      this.ui.cellRow = -1;
+      LiveTvRepository.selectGroup(chip.id);
+    }
+  },
+
+  activateFocused() {
+    const zone = this.ui.zone;
+    if (zone === "header") {
+      const action = this.headerActions()[this.ui.headerIndex];
+      if (action) this.activateHeader(action.id);
+      return;
+    }
+    if (zone === "state") {
+      const button = this.stateButtons()[this.ui.stateIndex];
+      if (button) this.activateHeader(button.id);
+      return;
+    }
+    if (zone === "chips") {
+      this.selectChip(this.ui.chipIndex);
+      return;
+    }
+    if (zone === "sort") {
+      const option = ON_NOW_SORT_OPTIONS[this.ui.sortIndex];
+      if (option) LiveTvRepository.setOnNowSort(option.id);
+      return;
+    }
+    if (zone === "channel") {
+      const channelId = this.focusedChannelId();
+      if (channelId) this.openChannelMenu(channelId);
+      return;
+    }
+    const channelId = this.focusedChannelId();
+    if (channelId) void this.playChannel(channelId);
+  },
+
+  toggleFavoriteFocused() {
+    const channelId = this.focusedChannelId();
+    if (channelId) LiveTvRepository.toggleFavorite(channelId);
+  },
+
+  // --- Keys -------------------------------------------------------------------------
+
+  consumeBackRequest() {
+    if (this.menu) {
+      this.closeMenu();
+      return true;
+    }
+    if (this.focusZone === "sidebar") return false;
+    this.openSidebar();
+    return true;
+  },
+
+  async onKeyDown(event) {
+    const code = keyCodeOf(event);
+    if (this.menu) {
+      event?.preventDefault?.();
+      if (code === KEY.UP || code === KEY.DOWN) {
+        const options = this.menuOptions();
+        this.menu.index = clamp(
+          this.menu.index + (code === KEY.UP ? -1 : 1),
+          0,
+          options.length - 1
+        );
+        this.renderMenu();
+        this.applyDomFocus();
+      } else if (code === KEY.ENTER && !event?.repeat) {
+        this.menuEnterArmed = true;
+      }
+      return;
+    }
+
+    if (this.layoutPrefs?.modernSidebar && !this.sidebarExpanded) {
+      if (code === KEY.DOWN) {
+        this.pillIconOnly = true;
+        setModernSidebarPillIconOnly(this.container, true);
+      } else if (code === KEY.UP) {
+        this.pillIconOnly = false;
+        setModernSidebarPillIconOnly(this.container, false);
+      }
+    }
+
+    if (this.focusZone === "sidebar") {
+      this.handleSidebarKey(event, code);
+      return;
+    }
+
+    if ([KEY.LEFT, KEY.UP, KEY.RIGHT, KEY.DOWN].includes(code)) {
+      event?.preventDefault?.();
+      if (!allowDpadRepeat(this, event, { horizontalMs: 90, verticalMs: 120 })) return;
+      this.handleArrow(code);
+      return;
+    }
+
+    if (code === KEY.ENTER) {
+      event?.preventDefault?.();
+      if (isLongPressCapable(this.ui.zone)) {
+        if (!event?.repeat) {
+          this.pendingEnter = { zone: this.ui.zone, startedAt: Date.now(), handled: false };
+        } else if (this.pendingEnter && !this.pendingEnter.handled) {
+          this.pendingEnter.handled = true;
+          const channelId = this.focusedChannelId();
+          if (channelId) this.openChannelMenu(channelId);
+        }
+        return;
+      }
+      if (!event?.repeat) this.activateFocused();
+      return;
+    }
+
+    if (code === KEY.RED || code === KEY.F) {
+      this.toggleFavoriteFocused();
+      return;
+    }
+    if (code === KEY.GREEN || code === KEY.G) {
+      LiveTvRepository.setViewMode(this.isOnNow() ? "Guide" : "OnNow");
+      return;
+    }
+    if (
+      this.status() === "ready" &&
+      !this.isOnNow() &&
+      (this.ui.zone === "grid" || this.ui.zone === "channel")
+    ) {
+      if (code === KEY.YELLOW) {
+        this.shiftGuideTime(-TIME_JUMP_MS);
+        this.renderContent();
+        return;
+      }
+      if (code === KEY.BLUE) {
+        this.shiftGuideTime(TIME_JUMP_MS);
+        this.renderContent();
+        return;
+      }
+      if (
+        code === KEY.CHANNEL_UP ||
+        code === KEY.PAGE_UP ||
+        code === KEY.CHANNEL_DOWN ||
+        code === KEY.PAGE_DOWN
+      ) {
+        event?.preventDefault?.();
+        this.moveGuideRow(code === KEY.CHANNEL_UP || code === KEY.PAGE_UP ? -1 : 1, { page: true });
+        this.renderContent();
+      }
+    }
+  },
+
+  onKeyUp(event) {
+    const code = keyCodeOf(event);
+    if ([KEY.LEFT, KEY.UP, KEY.RIGHT, KEY.DOWN].includes(code)) resetDpadRepeat(this);
+    if (code !== KEY.ENTER) return;
+    if (this.menu) {
+      if (this.menuEnterArmed) {
+        this.menuEnterArmed = false;
+        this.activateMenu();
+      }
+      return;
+    }
+    const pending = this.pendingEnter;
+    this.pendingEnter = null;
+    if (
+      !pending ||
+      pending.handled ||
+      pending.zone !== this.ui.zone ||
+      this.focusZone !== "content"
+    )
+      return;
+    const heldMs = Number(event?.keyDownDurationMs || Date.now() - pending.startedAt);
+    if (heldMs >= LONG_PRESS_MS) {
+      const channelId = this.focusedChannelId();
+      if (channelId) this.openChannelMenu(channelId);
+      return;
+    }
+    this.activateFocused();
+  },
+
+  handleSidebarKey(event, code) {
+    const nodes = getRootSidebarNodes(this.container, this.layoutPrefs);
+    const current = this.container.querySelector(".focusable.focused");
+    if (code === KEY.UP || code === KEY.DOWN) {
+      event?.preventDefault?.();
+      const index = Math.max(0, nodes.indexOf(current));
+      const next = clamp(index + (code === KEY.UP ? -1 : 1), 0, nodes.length - 1);
+      this.focusSidebarNode(nodes[next] || current);
+      return;
+    }
+    if (code === KEY.RIGHT) {
+      event?.preventDefault?.();
+      this.closeSidebarToContent();
+      return;
+    }
+    if (code === KEY.ENTER && current && isRootSidebarNode(current)) {
+      event?.preventDefault?.();
+      const action = String(current.dataset.action || "");
+      activateLegacySidebarAction(action, LIVE_TV_ROUTE);
+      if (isSelectedSidebarAction(action, LIVE_TV_ROUTE)) this.closeSidebarToContent();
+    }
+  },
+
+  handleArrow(code) {
+    const zone = this.ui.zone;
+    const up = code === KEY.UP;
+    const down = code === KEY.DOWN;
+    const left = code === KEY.LEFT;
+    const right = code === KEY.RIGHT;
+
+    if (zone === "grid" || zone === "channel") {
+      if (up || down) {
+        this.moveGuideRow(up ? -1 : 1);
+      } else if (zone === "channel") {
+        if (left) {
+          this.openSidebar();
+          return;
+        }
+        this.ui.zone = "grid";
+        this.ui.cellRow = -1;
+        this.ui.cursorTimeMs = Math.max(this.ui.cursorTimeMs, this.ui.viewStartMs || 0);
+      } else {
+        this.moveGuideCell(left ? -1 : 1);
+      }
+      this.renderContent();
+      return;
+    }
+
+    if (zone === "cards") {
+      const entries = this.onNowEntries();
+      const column = this.ui.cardIndex % ON_NOW_COLUMNS;
+      if (left) {
+        if (column === 0) {
+          this.openSidebar();
+          return;
+        }
+        this.ui.cardIndex -= 1;
+      } else if (right) {
+        if (column < ON_NOW_COLUMNS - 1 && this.ui.cardIndex + 1 < entries.length)
+          this.ui.cardIndex += 1;
+      } else if (up) {
+        if (this.ui.cardIndex - ON_NOW_COLUMNS < 0) {
+          this.setZone(this.previousZone("cards"));
+        } else {
+          this.ui.cardIndex -= ON_NOW_COLUMNS;
+        }
+      } else if (down) {
+        if (this.ui.cardIndex + ON_NOW_COLUMNS < entries.length) {
+          this.ui.cardIndex += ON_NOW_COLUMNS;
+        } else if (
+          Math.floor(this.ui.cardIndex / ON_NOW_COLUMNS) <
+          Math.floor((entries.length - 1) / ON_NOW_COLUMNS)
+        ) {
+          this.ui.cardIndex = entries.length - 1;
+        }
+      }
+      this.renderContent();
+      return;
+    }
+
+    const horizontal = {
+      header: { key: "headerIndex", count: () => this.headerActions().length },
+      chips: { key: "chipIndex", count: () => this.chips().length },
+      sort: { key: "sortIndex", count: () => ON_NOW_SORT_OPTIONS.length },
+      recents: { key: "recentIndex", count: () => this.recentChannels().length },
+      state: { key: "stateIndex", count: () => this.stateButtons().length }
+    }[zone];
+
+    if (horizontal && (left || right)) {
+      const index = this.ui[horizontal.key];
+      if (left && index === 0) {
+        this.openSidebar();
+        return;
+      }
+      this.ui[horizontal.key] = clamp(
+        index + (left ? -1 : 1),
+        0,
+        Math.max(0, horizontal.count() - 1)
+      );
+      this.renderContent();
+      return;
+    }
+
+    if (up || down) {
+      const target = up ? this.previousZone(zone) : this.nextZone(zone);
+      if (target) {
+        this.setZone(target);
+        if (target === "grid") this.ui.cellRow = -1;
+        this.renderContent();
+      }
+    }
+  },
+
+  // --- Magic Remote / mouse ---------------------------------------------------------
+
+  /** Points `this.ui` at a Live TV element (Magic Remote pointer or mouse). */
+  syncUiFromTarget(target) {
+    const node = target?.closest?.("[data-ltv-zone]");
+    if (!node || !this.container?.contains(node)) return null;
+    const zone = node.dataset.ltvZone;
+    if (zone === "menu") {
+      if (this.menu) this.menu.index = Number(node.dataset.ltvIndex || 0);
+      return zone;
+    }
+    if (this.menu) return null;
+    this.focusZone = "content";
+    this.ui.zone = zone;
+    if (zone === "grid") {
+      this.ui.row = Number(node.dataset.ltvRow || 0);
+      this.ui.cell = Number(node.dataset.ltvCell || 0);
+      this.ui.cellRow = this.ui.row;
+      this.ui.cellChannelId = this.visibleChannels()[this.ui.row]?.id;
+    } else if (zone === "channel") {
+      const channelId = node.dataset.ltvChannelId;
+      this.ui.row = Math.max(
+        0,
+        this.visibleChannels().findIndex((channel) => channel.id === channelId)
+      );
+    } else {
+      const key = {
+        header: "headerIndex",
+        chips: "chipIndex",
+        sort: "sortIndex",
+        recents: "recentIndex",
+        state: "stateIndex",
+        cards: "cardIndex"
+      }[zone];
+      if (key) this.ui[key] = Number(node.dataset.ltvIndex || 0);
+    }
+    return zone;
+  },
+
+  activatePointerTarget(target) {
+    const zone = this.syncUiFromTarget(target);
+    if (!zone) return false;
+    if (zone === "menu") {
+      this.activateMenu();
+      return true;
+    }
+    this.activateFocused();
+    this.renderContent();
+    return true;
+  },
+
+  // LG Magic Remote: hovering moves the remote's focus; clicking acts like OK.
+  onPointerFocus(target) {
+    // Keep the details panel in step with the programme under the pointer.
+    if (this.syncUiFromTarget(target) === "grid") this.renderContent();
+  },
+
+  onPointerActivate(target) {
+    return this.activatePointerTarget(target);
+  },
+
+  bindPointerEvents() {
+    const root = this.container;
+    if (!root || root.__ltvPointerBound) return;
+    root.__ltvPointerBound = true;
+    // Mouse clicks outside webOS (webOS clicks arrive through onPointerActivate).
+    root.addEventListener("click", (event) => {
+      if (Number(event?.detail || 0) === 0) return; // keyboard-generated click; keys are handled already
+      this.activatePointerTarget(event.target);
+    });
+  },
+
+  isPerformanceConstrained() {
+    return Boolean(
+      globalThis.document?.documentElement?.classList?.contains("performance-constrained")
+    );
+  },
+
+  exitApp() {
+    Platform.exitApp();
+  }
+};
diff --git a/js/livetv/ui/liveTvToast.js b/js/livetv/ui/liveTvToast.js
new file mode 100644
index 0000000000000000000000000000000000000000..88c0c88d48a0ad200c06a8e24d8a77e359c73a14
--- /dev/null
+++ b/js/livetv/ui/liveTvToast.js
@@ -0,0 +1,27 @@
+// A short message at the bottom of the screen ("Tuning to CNN…", "Switching to Backup 1…").
+
+const DEFAULT_DURATION_MS = 3000;
+let hideTimer = null;
+
+export function showLiveTvToast(message, { durationMs = DEFAULT_DURATION_MS } = {}) {
+  const text = String(message || "").trim();
+  if (!text || typeof document === "undefined") return;
+  let toast = document.getElementById("liveTvToast");
+  if (!toast) {
+    toast = document.createElement("div");
+    toast.id = "liveTvToast";
+    toast.className = "ltv-toast";
+    toast.setAttribute("role", "status");
+    toast.setAttribute("aria-live", "polite");
+    document.body.appendChild(toast);
+  }
+  toast.textContent = text;
+  toast.classList.add("is-visible");
+  clearTimeout(hideTimer);
+  hideTimer = setTimeout(() => toast.classList.remove("is-visible"), durationMs);
+}
+
+export function hideLiveTvToast() {
+  clearTimeout(hideTimer);
+  document.getElementById("liveTvToast")?.classList.remove("is-visible");
+}
