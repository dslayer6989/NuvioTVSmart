diff --git a/css/livetv.css b/css/livetv.css
new file mode 100644
index 0000000000000000000000000000000000000000..4242819025f4f13ed17079d92b60b1a288ba0e44
--- /dev/null
+++ b/css/livetv.css
@@ -0,0 +1,1474 @@
+/* Live TV: guide, On Now, channel menu, Home row, player overlay and theme fonts.
+   Colors come from the --ltv-* variables set by js/livetv/liveTvThemes.js.
+   Sizes are px on the fixed 1920x1080 TV canvas. Flex `gap` is avoided for older TVs. */
+
+:root {
+  --ltv-bg: #0d0d0d;
+  --ltv-surface: #141414;
+  --ltv-raised: #222222;
+  --ltv-panel: rgba(26, 26, 26, 0.88);
+  --ltv-grid: #2a2a2a;
+  --ltv-grid-strong: #444444;
+  --ltv-accent: #f5f5f5;
+  --ltv-accent-soft: #ffffff;
+  --ltv-highlight: #e0e0e0;
+  --ltv-deep: #9e9e9e;
+  --ltv-live: #ff3b6b;
+  --ltv-on-accent: #111111;
+  --ltv-text: #ffffff;
+  --ltv-text-2: #b3b3b3;
+  --ltv-text-3: #808080;
+  --ltv-past: #111111;
+  --ltv-future: #1f1f1f;
+  --ltv-airing: #2a2a2a;
+  --ltv-accent-gradient: linear-gradient(90deg, #9e9e9e, #f5f5f5, #e0e0e0);
+  --ltv-airing-gradient: linear-gradient(90deg, #333333, #2b2b2b);
+  --ltv-screen-gradient: linear-gradient(180deg, #121212, #0d0d0d, #080808);
+  --ltv-now-gradient: linear-gradient(180deg, #f5f5f5, #e0e0e0);
+  --ltv-progress-gradient: linear-gradient(90deg, #f5f5f5, #e0e0e0);
+  --ltv-logo-tile: linear-gradient(135deg, #262626, #141414);
+  --ltv-corner-scale: 1;
+  --ltv-heading-font: var(--app-font-family);
+  --ltv-heading-scale: 1;
+  --ltv-label-font: var(--app-font-family);
+  --ltv-label-scale: 1;
+}
+
+/* ---- Theme fonts ------------------------------------------------------------------- */
+
+@font-face {
+  font-family: "NuvioThemePixel";
+  src: url("../assets/fonts/theme/theme_silkscreen_regular.ttf") format("truetype");
+  font-weight: 400;
+  font-style: normal;
+}
+
+@font-face {
+  font-family: "NuvioThemePixel";
+  src: url("../assets/fonts/theme/theme_silkscreen_bold.ttf") format("truetype");
+  font-weight: 700;
+  font-style: normal;
+}
+
+@font-face {
+  font-family: "NuvioThemeTerminal";
+  src: url("../assets/fonts/theme/theme_vt323_regular.ttf") format("truetype");
+  font-weight: 400;
+  font-style: normal;
+}
+
+@font-face {
+  font-family: "NuvioThemeRetro";
+  src: url("../assets/fonts/theme/theme_audiowide_regular.ttf") format("truetype");
+  font-weight: 400;
+  font-style: normal;
+}
+
+@font-face {
+  font-family: "NuvioThemeCondensed";
+  src: url("../assets/fonts/theme/theme_oswald_variable.ttf") format("truetype");
+  font-weight: 200 700;
+  font-style: normal;
+}
+
+@font-face {
+  font-family: "NuvioThemeMarquee";
+  src: url("../assets/fonts/theme/theme_limelight_regular.ttf") format("truetype");
+  font-weight: 400;
+  font-style: normal;
+}
+
+@font-face {
+  font-family: "NuvioThemeRounded";
+  src: url("../assets/fonts/theme/theme_quicksand_variable.ttf") format("truetype");
+  font-weight: 300 700;
+  font-style: normal;
+}
+
+/* Theme heading/label fonts across the app (desktop parity). */
+.ltv-theme-heading-font .home-row-title,
+.ltv-theme-heading-font .seeall-title,
+.ltv-theme-heading-font .settings-group-title,
+.ltv-theme-heading-font .settings-dialog-title,
+.ltv-theme-heading-font .nuvio-dialog-title,
+.ltv-theme-heading-font .library-dialog-title,
+.ltv-theme-heading-font .home-hero-title-text,
+.ltv-theme-heading-font .series-detail-title,
+.ltv-theme-heading-font .player-title,
+.ltv-theme-heading-font .ltv-heading {
+  font-family: var(--ltv-heading-font);
+}
+
+.ltv-theme-label-font .home-nav-label,
+.ltv-theme-label-font .modern-sidebar-nav-label,
+.ltv-theme-label-font .ltv-pill,
+.ltv-theme-label-font .ltv-action-label,
+.ltv-theme-label-font .settings-row-title {
+  font-family: var(--ltv-label-font);
+}
+
+/* Scanlines over the whole app (Retro Cable, CRT Phosphor), never over the player. */
+html.ltv-scanlines body::after {
+  content: "";
+  position: fixed;
+  top: 0;
+  right: 0;
+  bottom: 0;
+  left: 0;
+  z-index: 2147483000;
+  pointer-events: none;
+  background: repeating-linear-gradient(
+    180deg,
+    rgba(0, 0, 0, 0.08) 0,
+    rgba(0, 0, 0, 0.08) 1px,
+    transparent 1px,
+    transparent 3px
+  );
+}
+
+html.ltv-scanlines.ltv-player-active body::after,
+html.ltv-scanlines.performance-constrained body::after {
+  display: none;
+}
+
+/* ---- Shared pieces ------------------------------------------------------------------ */
+
+.ltv-logo-tile {
+  position: relative;
+  display: -webkit-box;
+  display: flex;
+  -webkit-box-align: center;
+  align-items: center;
+  -webkit-box-pack: center;
+  justify-content: center;
+  overflow: hidden;
+  flex: 0 0 auto;
+  background: var(--ltv-logo-tile);
+  border: 1px solid var(--ltv-grid);
+  border-radius: calc(10px * var(--ltv-corner-scale));
+}
+
+.ltv-logo-monogram {
+  color: var(--ltv-text-2);
+  font-weight: 800;
+  font-size: 20px;
+  letter-spacing: 1px;
+}
+
+.ltv-logo-image {
+  position: absolute;
+  top: 8%;
+  left: 8%;
+  width: 84%;
+  height: 84%;
+  object-fit: contain;
+}
+
+.ltv-logo-tile.has-logo .ltv-logo-monogram {
+  visibility: hidden;
+}
+
+.ltv-live-badge {
+  display: inline-block;
+  padding: 3px 10px 3px 8px;
+  margin-right: 12px;
+  border-radius: calc(6px * var(--ltv-corner-scale));
+  background: var(--ltv-live);
+  color: #ffffff;
+  font-size: 15px;
+  font-weight: 800;
+  letter-spacing: 1.5px;
+  line-height: 20px;
+  vertical-align: middle;
+  white-space: nowrap;
+}
+
+.ltv-live-dot {
+  display: inline-block;
+  width: 9px;
+  height: 9px;
+  margin-right: 7px;
+  border-radius: 50%;
+  background: #ffffff;
+  vertical-align: 1px;
+}
+
+html.ltv-glow:not(.performance-constrained) .ltv-live-dot {
+  -webkit-animation: ltv-pulse 1.6s ease-in-out infinite;
+  animation: ltv-pulse 1.6s ease-in-out infinite;
+}
+
+@-webkit-keyframes ltv-pulse {
+  0%,
+  100% {
+    opacity: 1;
+  }
+  50% {
+    opacity: 0.35;
+  }
+}
+
+@keyframes ltv-pulse {
+  0%,
+  100% {
+    opacity: 1;
+  }
+  50% {
+    opacity: 0.35;
+  }
+}
+
+.ltv-progress {
+  display: block;
+  position: relative;
+  height: 6px;
+  border-radius: 3px;
+  background: rgba(255, 255, 255, 0.14);
+  overflow: hidden;
+}
+
+.ltv-progress-fill {
+  display: block;
+  height: 100%;
+  border-radius: 3px;
+  background: var(--ltv-progress-gradient);
+}
+
+html.ltv-glow:not(.performance-constrained) .ltv-progress-fill {
+  box-shadow: 0 0 8px var(--ltv-accent);
+}
+
+.ltv-star {
+  color: var(--ltv-highlight);
+  font-size: 22px;
+  line-height: 1;
+  margin-left: 10px;
+}
+
+.ltv-key-dot {
+  display: inline-block;
+  width: 14px;
+  height: 14px;
+  margin: 0 6px 0 14px;
+  border-radius: 50%;
+  vertical-align: -1px;
+}
+
+.ltv-key-dot.is-red {
+  background: #e53935;
+}
+
+.ltv-key-dot.is-green {
+  background: #43a047;
+}
+
+.ltv-key-dot.is-yellow {
+  background: #fdd835;
+}
+
+.ltv-key-dot.is-blue {
+  background: #1e88e5;
+}
+
+.ltv-pill {
+  display: inline-block;
+  height: 48px;
+  padding: 0 24px;
+  margin-right: 12px;
+  border: 2px solid var(--ltv-grid-strong);
+  border-radius: calc(24px * var(--ltv-corner-scale));
+  background: var(--ltv-raised);
+  color: var(--ltv-text-2);
+  font-family: inherit;
+  font-size: calc(20px * var(--ltv-label-scale));
+  font-weight: 600;
+  line-height: 44px;
+  white-space: nowrap;
+  outline: none;
+  cursor: pointer;
+}
+
+.ltv-pill.is-selected {
+  border-color: transparent;
+  background: var(--ltv-accent-gradient);
+  color: var(--ltv-on-accent);
+  font-weight: 800;
+}
+
+.ltv-pill.focused,
+.ltv-pill:focus {
+  border-color: var(--ltv-accent-soft);
+  -webkit-transform: scale(1.06);
+  transform: scale(1.06);
+  box-shadow: 0 0 0 3px var(--ltv-accent);
+}
+
+html.ltv-glow:not(.performance-constrained) .ltv-pill.focused {
+  box-shadow:
+    0 0 0 3px var(--ltv-accent),
+    0 0 18px var(--ltv-accent);
+}
+
+/* ---- Live TV screen shell ----------------------------------------------------------- */
+
+.livetv-shell {
+  background: var(--ltv-screen-gradient);
+  color: var(--ltv-text);
+}
+
+.livetv-main {
+  position: relative;
+  display: -webkit-box;
+  display: flex;
+  -webkit-box-orient: vertical;
+  flex-direction: column;
+  height: 100vh;
+  padding: 26px 48px 18px 48px;
+  overflow: hidden;
+}
+
+.tizen-tv .livetv-main {
+  height: 100%;
+}
+
+.livetv-shell.has-modern-sidebar .livetv-main {
+  padding-left: 140px;
+}
+
+.ltv-header {
+  display: -webkit-box;
+  display: flex;
+  -webkit-box-align: center;
+  align-items: center;
+  -webkit-box-pack: justify;
+  justify-content: space-between;
+  flex: 0 0 auto;
+  height: 84px;
+}
+
+.ltv-title {
+  margin: 0;
+  font-family: var(--ltv-heading-font);
+  font-size: calc(40px * var(--ltv-heading-scale));
+  font-weight: 800;
+  line-height: 48px;
+  letter-spacing: 0.5px;
+  color: var(--ltv-text);
+  white-space: nowrap;
+}
+
+.ltv-title .ltv-live-badge {
+  font-family: var(--app-font-family);
+}
+
+html.ltv-glow:not(.performance-constrained) .ltv-title-text {
+  text-shadow: 0 0 18px rgba(255, 255, 255, 0.18);
+}
+
+.ltv-subtitle {
+  margin-top: 2px;
+  color: var(--ltv-text-3);
+  font-size: 18px;
+  line-height: 24px;
+  white-space: nowrap;
+}
+
+.ltv-actions {
+  display: -webkit-box;
+  display: flex;
+  -webkit-box-align: center;
+  align-items: center;
+}
+
+.ltv-action {
+  display: -webkit-box;
+  display: flex;
+  -webkit-box-align: center;
+  align-items: center;
+  height: 56px;
+  padding: 0 22px 0 18px;
+  margin-left: 12px;
+  border: 2px solid var(--ltv-grid-strong);
+  border-radius: calc(28px * var(--ltv-corner-scale));
+  background: var(--ltv-raised);
+  color: var(--ltv-text-2);
+  font-family: inherit;
+  font-size: 20px;
+  font-weight: 600;
+  outline: none;
+  cursor: pointer;
+}
+
+.ltv-action-icon {
+  font-size: 26px;
+  margin-right: 10px;
+}
+
+.ltv-action-label {
+  font-size: calc(20px * var(--ltv-label-scale));
+  white-space: nowrap;
+}
+
+.ltv-action.is-selected {
+  border-color: var(--ltv-accent);
+  color: var(--ltv-accent);
+}
+
+.ltv-action.focused,
+.ltv-action:focus {
+  border-color: transparent;
+  background: var(--ltv-accent-gradient);
+  color: var(--ltv-on-accent);
+  -webkit-transform: scale(1.05);
+  transform: scale(1.05);
+}
+
+html.ltv-glow:not(.performance-constrained) .ltv-action.focused {
+  box-shadow: 0 0 20px var(--ltv-accent);
+}
+
+.ltv-chips {
+  flex: 0 0 auto;
+  height: 68px;
+  padding-top: 8px;
+  overflow: hidden;
+  white-space: nowrap;
+}
+
+.ltv-chips.is-hidden {
+  display: none;
+}
+
+.ltv-chip-track {
+  display: inline-block;
+  padding: 4px 6px;
+  white-space: nowrap;
+  -webkit-transition: -webkit-transform 160ms ease-out;
+  transition: transform 160ms ease-out;
+}
+
+.ltv-body {
+  position: relative;
+  -webkit-box-flex: 1;
+  flex: 1 1 auto;
+  min-height: 0;
+  display: -webkit-box;
+  display: flex;
+  -webkit-box-orient: vertical;
+  flex-direction: column;
+}
+
+/* ---- Details panel ------------------------------------------------------------------ */
+
+.ltv-details {
+  display: -webkit-box;
+  display: flex;
+  -webkit-box-align: center;
+  align-items: center;
+  flex: 0 0 auto;
+  height: 168px;
+  padding: 16px 22px;
+  margin-bottom: 14px;
+  border: 1px solid var(--ltv-grid);
+  border-radius: calc(18px * var(--ltv-corner-scale));
+  background: var(--ltv-panel);
+}
+
+.ltv-details-logo {
+  width: 210px;
+  height: 128px;
+  margin-right: 26px;
+}
+
+.ltv-details-logo .ltv-logo-monogram {
+  font-size: 34px;
+}
+
+.ltv-details-copy {
+  -webkit-box-flex: 1;
+  flex: 1 1 auto;
+  min-width: 0;
+}
+
+.ltv-details-title-row {
+  display: -webkit-box;
+  display: flex;
+  -webkit-box-align: center;
+  align-items: center;
+  white-space: nowrap;
+}
+
+.ltv-details-title {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  font-family: var(--ltv-heading-font);
+  font-size: calc(32px * var(--ltv-heading-scale));
+  font-weight: 800;
+  line-height: 42px;
+  color: var(--ltv-text);
+}
+
+.ltv-details-meta {
+  margin-top: 4px;
+  color: var(--ltv-accent);
+  font-size: 20px;
